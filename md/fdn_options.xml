<?xml version="1.0" encoding="utf-8"?>
<mdscript name="FDN_Options" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="md.xsd">
  <!--
    Card X4-10b. FDN settings page on the game's Extension Options menu, using SirNuke's
    Mod Support APIs (Simple Menu Options). OPTIONAL: without that extension nothing here ever runs
    and FDN keeps working with its defaults and saved overrides.

    How values flow:
    - The FDN save (md.FDN_Core.Init.$Overrides) is the only source of truth.
    - Each time the API reloads (every game load / UI reload) every option is registered with
      skip_initial_callback, then the API's stored copy is overwritten with FDN's current value
      (Write_Option_Value does not call back). So the page always shows this save's real values,
      and untouched settings never become overrides (later default changes still apply).
    - Only when the player changes an option does On_Change call md.FDN_Core.Cfg_Set, which logs
      the change in fdn.log and refuses unknown keys.
    - Card X4-17b: registration and On_Change use Cfg_Lookup (Found/Value) so default-off buttons
      (TransferDelay) whose value is 0 still appear and can be turned off again.
      Unknown keys are still skipped (Found 0), not silently shown as 0.
    - Card X4-10c: On_Change compares in page units (whole percent for fee factors) with the value
      in effect and writes nothing when they match (slider released on the same value). The log line is
      "setting Key changed from old to new (options page)". Displayed values are clamped to the
      slider's min/max (a saved value outside the range shows at the edge; the save is not changed).
    - Fee factors are decimals in FDN (0.2) and shown as decimals on the page (0.2).
    - Card X4-10d: fee factor sliders use $Scale 0 (decimal 0 to 1, step 0.1, 1 decimal). Values are rounded
      to 0.01 before compare/save (floats can come back as 0.2000001). Their option ids end in '_f' so
      the API's stored whole-percent values from 10b/10c (old ids fdn_FeeRangeMult etc.) are never reused;
      the old ids are no longer registered or written.
    - Card X4-10e: TransferFeePercent uses $Scale 0 too (0.0 to 10.0 percent, step 0.5, 1 decimal, ' %'),
      new id fdn_TransferFeePercent_f so the old whole-percent id fdn_TransferFeePercent is never reused.
      The fee maths in fdn_supply.xml already takes fractional percents (percent x 1000 as one whole number).
    - Card X4-21a: on/off button 'Manager skill sets range and fees' (ManagerSkill, default 1), after Maximum supply range.
    - Card X4-22d: 'Shortage alerts' on/off (ShortageAlerts, default 1), 'Shortage alert after' (ShortageAlertMinutes, 1 to 120 min,
      default 10) and 'Repeat shortage alert after' (ShortageRepeatMinutes, 5 to 240 min, default 30), after Repeat skip entries after.
    - Card X4-22e: on/off button 'Set trade buy limits' (TradeBuyLimits, default 1), after Supply station resources.
    - Card X4-23a: option names, mouseovers and unit words come from the FDN text page 477605 (t/0001-l044.xml):
      names 1101-1143 and mouseovers 1201-1243 in display order, Reset all 1199/1299, units 1001-1004 (jumps, min,
      pct, s; the space before them stays here). The category stays 'FDN' and the ' %' and ' Cr' suffixes stay as
      they are (not translated). Option ids, keys and the fdn.log lines are unchanged.
  -->
  <cues>
    <cue name="Register" instantiate="true">
      <conditions>
        <event_cue_signalled cue="md.Simple_Menu_Options.Reloaded" />
      </conditions>
      <actions>
        <!-- FDN not set up yet in this save (first load after adding FDN): try again on the next load -->
        <do_if value="not md.FDN_Core.Init.$Defaults?">
          <debug_text text="player.age + ' FDN WARN settings page not registered: FDN core not ready yet, reload the save'" filter="general" />
        </do_if>
        <do_else>
        <include_actions ref="Option_List" />
        <do_for_each name="$Opt" in="$List">
          <!-- Card X4-17b: Cfg_Lookup so value 0 (TransferDelay) still registers.
               Unknown keys (Found 0) still skip - not silently shown as 0. -->
          <run_actions ref="md.FDN_Core.Cfg_Lookup" result="$Res">
            <param name="Key" value="$Opt.$Key" />
          </run_actions>
          <do_if value="not $Res?">
            <continue />
          </do_if>
          <do_if value="not $Res.$Found">
            <continue />
          </do_if>
          <set_value name="$Cur" exact="$Res.$Value" />
          <do_if value="$Opt.$Scale == 0">
            <set_value name="$Show" exact="((($Cur * 100.0) + 0.5)i) / 100.0" />
          </do_if>
          <do_else>
            <set_value name="$Show" exact="($Cur)i" />
          </do_else>
          <do_if value="$Opt.$args? and $Opt.$args.$min? and $Show lt $Opt.$args.$min">
            <set_value name="$Show" exact="$Opt.$args.$min" />
          </do_if>
          <do_if value="$Opt.$args? and $Opt.$args.$max? and $Show gt $Opt.$args.$max">
            <set_value name="$Show" exact="$Opt.$args.$max" />
          </do_if>
          <set_value name="$Reg" exact="table[
            $id = 'fdn_' + $Opt.$Key + $Opt.$IdSuffix,
            $category = 'FDN',
            $name = $Opt.$name,
            $mouseover = $Opt.$mouseover,
            $type = $Opt.$type,
            $default = $Show,
            $callback = On_Change,
            $echo = table[$Key = $Opt.$Key, $Scale = $Opt.$Scale],
            $skip_initial_callback = 1]" />
          <do_if value="$Opt.$args?">
            <set_value name="$Reg.$args" exact="$Opt.$args" />
          </do_if>
          <signal_cue_instantly cue="md.Simple_Menu_Options.Register_Option" param="$Reg" />
          <signal_cue_instantly cue="md.Simple_Menu_Options.Write_Option_Value" param="table[$id = 'fdn_' + $Opt.$Key + $Opt.$IdSuffix, $value = $Show]" />
        </do_for_each>
        <!-- Reset all: an on/off button that acts on any click, then shows off again -->
        <signal_cue_instantly cue="md.Simple_Menu_Options.Register_Option" param="table[
          $id = 'fdn_ResetAll',
          $category = 'FDN',
          $name = {477605,1199},
          $mouseover = {477605,1299},
          $type = 'button',
          $default = 0,
          $callback = On_Reset_All,
          $skip_initial_callback = 1]" />
        <signal_cue_instantly cue="md.Simple_Menu_Options.Write_Option_Value" param="table[$id = 'fdn_ResetAll', $value = 0]" />
        </do_else>
      </actions>
    </cue>

    <!-- Player changed one option. event.param = table[$id, $value, $echo] (echo = $Key, $Scale) -->
    <cue name="On_Change" instantiate="true">
      <conditions>
        <event_cue_signalled />
      </conditions>
      <actions>
        <!-- Card X4-17b: do not gate on event.param.$value? (blocks off/zero). Require echo.
             Presence of $value is keys.list.indexof == 0 means absent (lib_generic / not indexof);
             do not compare the value to null (unproven whether integer 0 equals null). Compare via Cfg_Lookup. -->
        <do_if value="md.FDN_Core.Init.$Defaults? and event.param.$echo?">
        <set_value name="$Echo" exact="event.param.$echo" />
        <set_value name="$PKeys" exact="event.param.keys.list" />
        <do_if value="$PKeys.indexof.{'$value'} == 0">
          <debug_text text="player.age + ' FDN WARN options On_Change missing $value key for ' + $Echo.$Key" filter="general" />
        </do_if>
        <do_else>
        <set_value name="$Raw" exact="event.param.$value" />
        <do_if value="$Echo.$Scale == 0">
          <set_value name="$Value" exact="((($Raw * 100.0) + 0.5)i) / 100.0" />
        </do_if>
        <do_else>
          <set_value name="$Value" exact="($Raw)i" />
        </do_else>
        <run_actions ref="md.FDN_Core.Cfg_Lookup" result="$Res">
          <param name="Key" value="$Echo.$Key" />
        </run_actions>
        <set_value name="$Same" exact="false" />
        <do_if value="$Res?">
          <do_if value="$Res.$Found">
            <set_value name="$Cur" exact="$Res.$Value" />
            <do_if value="$Echo.$Scale == 0">
              <set_value name="$Same" exact="(($Cur * 100.0) + 0.5)i == (($Raw * 100.0) + 0.5)i" />
            </do_if>
            <do_else>
              <set_value name="$Same" exact="($Cur)i == ($Raw)i" />
            </do_else>
          </do_if>
        </do_if>
        <do_if value="not $Same">
          <run_actions ref="md.FDN_Core.Cfg_Set" result="$Ok">
            <param name="Key" value="$Echo.$Key" />
            <param name="Value" value="$Value" />
            <param name="Source" value="' (options page)'" />
          </run_actions>
        </do_if>
        </do_else>
        </do_if>
      </actions>
    </cue>

    <!-- Player clicked Reset all -->
    <cue name="On_Reset_All" instantiate="true">
      <conditions>
        <event_cue_signalled />
      </conditions>
      <actions>
        <do_if value="md.FDN_Core.Init.$Defaults?">
        <run_actions ref="md.FDN_Core.Cfg_Reset_All" result="$Ok" />
        <run_actions ref="md.FDN_Core.Log">
          <param name="Level" value="3" />
          <param name="Text" value="'all settings reset via options page'" />
        </run_actions>
        <!-- Put the page's stored values back to the defaults (no callbacks) -->
        <include_actions ref="Option_List" />
        <do_for_each name="$Opt" in="$List">
          <run_actions ref="md.FDN_Core.Cfg_Lookup" result="$Res">
            <param name="Key" value="$Opt.$Key" />
          </run_actions>
          <do_if value="$Res?">
          <do_if value="$Res.$Found">
            <set_value name="$Cur" exact="$Res.$Value" />
            <do_if value="$Opt.$Scale == 0">
              <set_value name="$Show" exact="((($Cur * 100.0) + 0.5)i) / 100.0" />
            </do_if>
            <do_else>
              <set_value name="$Show" exact="($Cur)i" />
            </do_else>
            <do_if value="$Opt.$args? and $Opt.$args.$min? and $Show lt $Opt.$args.$min">
              <set_value name="$Show" exact="$Opt.$args.$min" />
            </do_if>
            <do_if value="$Opt.$args? and $Opt.$args.$max? and $Show gt $Opt.$args.$max">
              <set_value name="$Show" exact="$Opt.$args.$max" />
            </do_if>
            <signal_cue_instantly cue="md.Simple_Menu_Options.Write_Option_Value" param="table[$id = 'fdn_' + $Opt.$Key + $Opt.$IdSuffix, $value = $Show]" />
          </do_if>
          </do_if>
        </do_for_each>
        <signal_cue_instantly cue="md.Simple_Menu_Options.Write_Option_Value" param="table[$id = 'fdn_ResetAll', $value = 0]" />
        </do_if>
      </actions>
    </cue>

    <!-- The options shown on the page, in display order. $Scale 0 = decimal fee factor (id + '_f'), $Scale 1 = whole number or on/off -->
    <library name="Option_List">
      <actions>
        <set_value name="$List" exact="[]" />
        <append_to_list name="$List" exact="table[$Key = 'NpcFallback', $type = 'button', $name = {477605,1101}, $mouseover = {477605,1201}, $IdSuffix = '', $Scale = 1]" />
        <append_to_list name="$List" exact="table[$Key = 'LogbookLevel', $type = 'slidercell', $name = {477605,1102}, $mouseover = {477605,1202}, $IdSuffix = '', $Scale = 1, $args = table[$min = 0, $max = 3, $step = 1, $suffix = '']]" />
        <append_to_list name="$List" exact="table[$Key = 'NotifyMoneySkip', $type = 'button', $name = {477605,1103}, $mouseover = {477605,1203}, $IdSuffix = '', $Scale = 1]" />
        <append_to_list name="$List" exact="table[$Key = 'LogbookSkipInterval', $type = 'slidercell', $name = {477605,1104}, $mouseover = {477605,1204}, $IdSuffix = '', $Scale = 1, $args = table[$min = 60, $max = 3600, $step = 60, $suffix = ' ' + {477605,1004}]]" />
        <append_to_list name="$List" exact="table[$Key = 'ShortageAlerts', $type = 'button', $name = {477605,1105}, $mouseover = {477605,1205}, $IdSuffix = '', $Scale = 1]" comment="card X4-22d" />
        <append_to_list name="$List" exact="table[$Key = 'ShortageAlertMinutes', $type = 'slidercell', $name = {477605,1106}, $mouseover = {477605,1206}, $IdSuffix = '', $Scale = 1, $args = table[$min = 1, $max = 120, $step = 1, $suffix = ' ' + {477605,1002}]]" comment="card X4-22d" />
        <append_to_list name="$List" exact="table[$Key = 'ShortageRepeatMinutes', $type = 'slidercell', $name = {477605,1107}, $mouseover = {477605,1207}, $IdSuffix = '', $Scale = 1, $args = table[$min = 5, $max = 240, $step = 5, $suffix = ' ' + {477605,1002}]]" comment="card X4-22d" />
        <append_to_list name="$List" exact="table[$Key = 'PollInterval', $type = 'slidercell', $name = {477605,1108}, $mouseover = {477605,1208}, $IdSuffix = '', $Scale = 1, $args = table[$min = 10, $max = 600, $step = 10, $suffix = ' ' + {477605,1004}]]" />
        <append_to_list name="$List" exact="table[$Key = 'PollStationsPerPass', $type = 'slidercell', $name = {477605,1109}, $mouseover = {477605,1209}, $IdSuffix = '', $Scale = 1, $args = table[$min = 1, $max = 20, $step = 1, $suffix = '']]" />
        <append_to_list name="$List" exact="table[$Key = 'TriggerMinGap', $type = 'slidercell', $name = {477605,1110}, $mouseover = {477605,1210}, $IdSuffix = '', $Scale = 1, $args = table[$min = 0, $max = 300, $step = 5, $suffix = ' ' + {477605,1004}]]" />
        <append_to_list name="$List" exact="table[$Key = 'CyclesToCover', $type = 'slidercell', $name = {477605,1111}, $mouseover = {477605,1211}, $IdSuffix = '', $Scale = 1, $args = table[$min = 0, $max = 10, $step = 1, $suffix = '']]" />
        <append_to_list name="$List" exact="table[$Key = 'ResourcesFdnManaged', $type = 'button', $name = {477605,1112}, $mouseover = {477605,1212}, $IdSuffix = '', $Scale = 1]" />
        <append_to_list name="$List" exact="table[$Key = 'TradeBuyLimits', $type = 'button', $name = {477605,1113}, $mouseover = {477605,1213}, $IdSuffix = '', $Scale = 1]" comment="card X4-22e" />
        <append_to_list name="$List" exact="table[$Key = 'ProductsFdnManaged', $type = 'button', $name = {477605,1114}, $mouseover = {477605,1214}, $IdSuffix = '', $Scale = 1]" />
        <append_to_list name="$List" exact="table[$Key = 'OverstockTriggerPct', $type = 'slidercell', $name = {477605,1115}, $mouseover = {477605,1215}, $IdSuffix = '', $Scale = 1, $args = table[$min = 0, $max = 100, $step = 5, $suffix = ' ' + {477605,1003}]]" />
        <append_to_list name="$List" exact="table[$Key = 'ProductCyclesToKeep', $type = 'slidercell', $name = {477605,1116}, $mouseover = {477605,1216}, $IdSuffix = '', $Scale = 1, $args = table[$min = 0, $max = 10, $step = 1, $suffix = '']]" />
        <append_to_list name="$List" exact="table[$Key = 'ProductMinBatch', $type = 'slidercell', $name = {477605,1117}, $mouseover = {477605,1217}, $IdSuffix = '', $Scale = 1, $args = table[$min = 0, $max = 5000, $step = 50, $suffix = '']]" />
        <append_to_list name="$List" exact="table[$Key = 'DCNetworkRange', $type = 'slidercell', $name = {477605,1118}, $mouseover = {477605,1218}, $IdSuffix = '', $Scale = 1, $args = table[$min = 1, $max = 30, $step = 1, $suffix = ' ' + {477605,1001}]]" />
        <append_to_list name="$List" exact="table[$Key = 'DCKeepPercent', $type = 'slidercell', $name = {477605,1119}, $mouseover = {477605,1219}, $IdSuffix = '', $Scale = 1, $args = table[$min = 0, $max = 90, $step = 5, $suffix = ' %']]" />
        <append_to_list name="$List" exact="table[$Key = 'LedgerMax', $type = 'slidercell', $name = {477605,1120}, $mouseover = {477605,1220}, $IdSuffix = '', $Scale = 1, $args = table[$min = 50, $max = 1000, $step = 50, $suffix = '']]" />
        <append_to_list name="$List" exact="table[$Key = 'RangeLimit', $type = 'button', $name = {477605,1121}, $mouseover = {477605,1221}, $IdSuffix = '', $Scale = 1]" />
        <append_to_list name="$List" exact="table[$Key = 'RangeMaxJumps', $type = 'slidercell', $name = {477605,1122}, $mouseover = {477605,1222}, $IdSuffix = '', $Scale = 1, $args = table[$min = 1, $max = 30, $step = 1, $suffix = ' ' + {477605,1001}]]" />
        <append_to_list name="$List" exact="table[$Key = 'ManagerSkill', $type = 'button', $name = {477605,1123}, $mouseover = {477605,1223}, $IdSuffix = '', $Scale = 1]" comment="card X4-21a: default 1, registers through Cfg_Lookup like the other on/off settings" />
        <append_to_list name="$List" exact="table[$Key = 'TransferDelay', $type = 'button', $name = {477605,1124}, $mouseover = {477605,1224}, $IdSuffix = '', $Scale = 1]" />
        <append_to_list name="$List" exact="table[$Key = 'TransferDelayMult', $type = 'slidercell', $name = {477605,1125}, $mouseover = {477605,1225}, $IdSuffix = '', $Scale = 1, $args = table[$min = 0, $max = 60, $step = 1, $suffix = ' ' + {477605,1004}]]" />
        <append_to_list name="$List" exact="table[$Key = 'TransferFeePercent', $type = 'slidercell', $name = {477605,1126}, $mouseover = {477605,1226}, $IdSuffix = '_f', $Scale = 0, $args = table[$min = 0.0, $max = 10.0, $step = 0.5, $accuracyOverride = 1, $suffix = ' %']]" />
        <append_to_list name="$List" exact="table[$Key = 'FeeRangeMult', $type = 'slidercell', $name = {477605,1127}, $mouseover = {477605,1227}, $IdSuffix = '_f', $Scale = 0, $args = table[$min = 0.0, $max = 1.0, $step = 0.1, $accuracyOverride = 1, $suffix = '']]" />
        <append_to_list name="$List" exact="table[$Key = 'FeeVolumeMult', $type = 'slidercell', $name = {477605,1128}, $mouseover = {477605,1228}, $IdSuffix = '_f', $Scale = 0, $args = table[$min = 0.0, $max = 3.0, $step = 0.1, $accuracyOverride = 1, $suffix = '']]" />
        <append_to_list name="$List" exact="table[$Key = 'FeeTypeMult', $type = 'slidercell', $name = {477605,1129}, $mouseover = {477605,1229}, $IdSuffix = '_f', $Scale = 0, $args = table[$min = 0.0, $max = 3.0, $step = 0.1, $accuracyOverride = 1, $suffix = '']]" />
        <append_to_list name="$List" exact="table[$Key = 'ReturnFeeMult', $type = 'slidercell', $name = {477605,1130}, $mouseover = {477605,1230}, $IdSuffix = '_f', $Scale = 0, $args = table[$min = 0.0, $max = 1.0, $step = 0.1, $accuracyOverride = 1, $suffix = '']]" />
        <append_to_list name="$List" exact="table[$Key = 'DCToDCFeeMult', $type = 'slidercell', $name = {477605,1131}, $mouseover = {477605,1231}, $IdSuffix = '_f', $Scale = 0, $args = table[$min = 0.0, $max = 1.0, $step = 0.1, $accuracyOverride = 1, $suffix = '']]" />
        <append_to_list name="$List" exact="table[$Key = 'CharterFeePercent', $type = 'slidercell', $name = {477605,1132}, $mouseover = {477605,1232}, $IdSuffix = '', $Scale = 1, $args = table[$min = 0, $max = 200, $step = 5, $suffix = ' %']]" />
        <append_to_list name="$List" exact="table[$Key = 'CharterFeeFloor', $type = 'slidercell', $name = {477605,1133}, $mouseover = {477605,1233}, $IdSuffix = '', $Scale = 1, $args = table[$min = 0, $max = 10000000, $step = 100000, $suffix = ' Cr']]" />
        <append_to_list name="$List" exact="table[$Key = 'CharterFeeCap', $type = 'slidercell', $name = {477605,1134}, $mouseover = {477605,1234}, $IdSuffix = '', $Scale = 1, $args = table[$min = 0, $max = 20000000, $step = 250000, $suffix = ' Cr']]" />
        <append_to_list name="$List" exact="table[$Key = 'CharterMinStanding', $type = 'slidercell', $name = {477605,1135}, $mouseover = {477605,1235}, $IdSuffix = '', $Scale = 1, $args = table[$min = -30, $max = 30, $step = 1, $suffix = '']]" />
        <append_to_list name="$List" exact="table[$Key = 'CharterDiscStep1', $type = 'slidercell', $name = {477605,1136}, $mouseover = {477605,1236}, $IdSuffix = '', $Scale = 1, $args = table[$min = -30, $max = 30, $step = 1, $suffix = '']]" />
        <append_to_list name="$List" exact="table[$Key = 'CharterDisc1', $type = 'slidercell', $name = {477605,1137}, $mouseover = {477605,1237}, $IdSuffix = '', $Scale = 1, $args = table[$min = 0, $max = 90, $step = 5, $suffix = ' %']]" />
        <append_to_list name="$List" exact="table[$Key = 'CharterDiscStep2', $type = 'slidercell', $name = {477605,1138}, $mouseover = {477605,1238}, $IdSuffix = '', $Scale = 1, $args = table[$min = -30, $max = 30, $step = 1, $suffix = '']]" />
        <append_to_list name="$List" exact="table[$Key = 'CharterDisc2', $type = 'slidercell', $name = {477605,1139}, $mouseover = {477605,1239}, $IdSuffix = '', $Scale = 1, $args = table[$min = 0, $max = 90, $step = 5, $suffix = ' %']]" />
        <append_to_list name="$List" exact="table[$Key = 'CharterDiscStep3', $type = 'slidercell', $name = {477605,1140}, $mouseover = {477605,1240}, $IdSuffix = '', $Scale = 1, $args = table[$min = -30, $max = 30, $step = 1, $suffix = '']]" />
        <append_to_list name="$List" exact="table[$Key = 'CharterDisc3', $type = 'slidercell', $name = {477605,1141}, $mouseover = {477605,1241}, $IdSuffix = '', $Scale = 1, $args = table[$min = 0, $max = 90, $step = 5, $suffix = ' %']]" />
        <append_to_list name="$List" exact="table[$Key = 'DebugLog', $type = 'button', $name = {477605,1142}, $mouseover = {477605,1242}, $IdSuffix = '', $Scale = 1]" />
        <append_to_list name="$List" exact="table[$Key = 'LogLevel', $type = 'slidercell', $name = {477605,1143}, $mouseover = {477605,1243}, $IdSuffix = '', $Scale = 1, $args = table[$min = 1, $max = 4, $step = 1, $suffix = '']]" />
      </actions>
    </library>
  </cues>
</mdscript>
