<?xml version="1.0" encoding="utf-8"?>
<mdscript name="FDN_Menu" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="md.xsd">
  <!--
    Cards X4-11a/11b. Station right-click entries, using SirNuke's Mod Support APIs (Interact Menu API).
    OPTIONAL like fdn_options.xml: without that extension md.Interact_Menu_API.Get_Actions is never
    signalled, so nothing here runs and FDN keeps working.

    On every player-owned station's right-click menu two entries are added:
       'FDN: resource supply ON/OFF'   per-station ResourcesFdnManaged
      'FDN: send products to DC ON/OFF' per-station ProductsFdnManaged
    On a DC the products entry is hidden: a DC keeps its own products. Card X4-14c: DC = FDN charter plus a working
    qualifying dock (same rule as md.FDN_Supply.Find_DCs / md.FDN_Core.Charter_Review).
    The label shows the value in effect for that station (station override, else player setting, else default).
    Picking one flips it (1 to 0, 0 to 1) with md.FDN_Core.Station_Cfg_Set, which writes the fdn.log line
    "station setting Key at Station changed from old to new (menu)". A logbook 'info' entry (LogbookLevel 2+)
    records the change; a refused change writes a logbook 'problem' entry (LogbookLevel 1+).
    The API removes its actions when a menu closes, so they are re-added on every menu opening.
    If FDN is not set up yet in this save, one greyed-out entry says so.

    Card X4-14b: a third entry buys an FDN charter for the station (md.FDN_Core.Charter_Fee works out the fee).
      'FDN: buy charter (X Cr)'   allowed: clicking charges the player at once (no confirmation, no refund)
      'FDN: charter blocked - reason'  greyed, the reason is in the label and the mouseover
      'FDN: charter active'       greyed, the station already has one
      'FDN: revoke charter (no refund)'  card X4-14c, shown with 'charter active': clicking ends the charter at once
                                  (no confirmation, no refund) and the station stops being a DC
    Card X4-14c: the charter makes the station a DC (md.FDN_Supply.Find_DCs). A revoke writes fdn.log (WARN) and a
    logbook 'notice' entry (md.FDN_Core.Charter_End).
    Every purchase and every refusal on click writes an fdn.log line (level 2) and a logbook entry
    ('notice' for a purchase, 'problem' for a refusal, both LogbookLevel 1+).
  -->
  <cues>
    <cue name="Add_Station_Actions" instantiate="true">
      <conditions>
        <event_cue_signalled cue="md.Interact_Menu_API.Get_Actions" />
      </conditions>
      <actions>
        <do_if value="event.param.$object?">
          <set_value name="$Station" exact="event.param.$object" />
          <do_if value="$Station != null and $Station.exists and $Station.isclass.station and $Station.isplayerowned">
            <do_if value="not md.FDN_Core.Init.$Defaults?">
              <signal_cue_instantly cue="md.Interact_Menu_API.Add_Action" param="table[
                $id = 'fdn_station_notready',
                $text = 'FDN: not ready',
                $mouseover = 'FDN is not set up in this save yet. Save and reload, then try again',
                $active = false]" />
            </do_if>
            <do_else>
              <include_actions ref="Entry_List" />
              <!-- Card X4-14c: a DC is a station with an FDN charter and a working qualifying dock (as Find_DCs) -->
              <set_value name="$IsDC" exact="false" />
              <run_actions ref="md.FDN_Core.Charter_Get" result="$ChDC">
                <param name="Station" value="$Station" />
              </run_actions>
              <do_if value="$ChDC != null">
                <run_actions ref="md.FDN_Core.Charter_Has_Dock" result="$IsDC">
                  <param name="Station" value="$Station" />
                </run_actions>
              </do_if>
              <do_for_each name="$E" in="$List">
                <do_if value="$IsDC and $E.$Key == 'ProductsFdnManaged'">
                  <continue />
                </do_if>
                <run_actions ref="md.FDN_Core.Station_Cfg_Get" result="$Cur">
                  <param name="Station" value="$Station" />
                  <param name="Key" value="$E.$Key" />
                </run_actions>
                <set_value name="$State" exact="'OFF'" />
                <set_value name="$Next" exact="'on'" />
                <do_if value="$Cur == 1">
                  <set_value name="$State" exact="'ON'" />
                  <set_value name="$Next" exact="'off'" />
                </do_if>
                <signal_cue_instantly cue="md.Interact_Menu_API.Add_Action" param="table[
                  $id = 'fdn_station_' + $E.$Key,
                  $text = 'FDN: ' + $E.$Label + ' ' + $State,
                  $mouseover = $E.$Mouseover + '. Click to turn it ' + $Next + ' for this station',
                  $callback = On_Toggle,
                  $echo = $E.$Key]" />
              </do_for_each>
              <include_actions ref="Charter_Entry" />
            </do_else>
          </do_if>
        </do_if>
      </actions>
    </cue>

    <!-- Card X4-14b: the charter entry. Uses $Station from Add_Station_Actions -->
    <library name="Charter_Entry">
      <actions>
        <run_actions ref="md.FDN_Core.Charter_Get" result="$Ch">
          <param name="Station" value="$Station" />
        </run_actions>
        <do_if value="$Ch != null">
          <signal_cue_instantly cue="md.Interact_Menu_API.Add_Action" param="table[
            $id = 'fdn_station_charter',
            $text = 'FDN: charter active',
            $mouseover = 'This station has an FDN charter and is a Distribution Centre while it has a working dock or pier',
            $active = false]" />
          <signal_cue_instantly cue="md.Interact_Menu_API.Add_Action" param="table[
            $id = 'fdn_station_charter_revoke',
            $text = 'FDN: revoke charter (no refund)',
            $mouseover = 'Click to end the FDN charter of this station at once. No confirmation and no refund. The station stops being a Distribution Centre',
            $callback = md.FDN_Menu.On_Revoke_Charter,
            $echo = 'revoke']" />
        </do_if>
        <do_else>
          <run_actions ref="md.FDN_Menu.Charter_Check" result="$Chk">
            <param name="Station" value="$Station" />
          </run_actions>
          <do_if value="$Chk.$Ok">
            <signal_cue_instantly cue="md.Interact_Menu_API.Add_Action" param="table[
              $id = 'fdn_station_charter',
              $text = 'FDN: buy charter (%1 Cr)'.[$Chk.$Info.$Fee.formatted.default],
              $mouseover = 'Click to pay %1 Cr now for an FDN charter on this station. It becomes a Distribution Centre. No confirmation and no refund'.[$Chk.$Info.$Fee.formatted.default],
              $callback = md.FDN_Menu.On_Buy_Charter,
              $echo = 'charter']" />
          </do_if>
          <do_else>
            <signal_cue_instantly cue="md.Interact_Menu_API.Add_Action" param="table[
              $id = 'fdn_station_charter',
              $text = 'FDN: charter blocked - ' + $Chk.$Reason,
              $mouseover = 'FDN charter not possible here: ' + $Chk.$Reason,
              $active = false]" />
          </do_else>
        </do_else>
      </actions>
    </library>

    <!-- Card X4-14b: can the player buy a charter for Station now? Returns table[$Ok, $Reason, $Info (Charter_Fee result)] -->
    <library name="Charter_Check" purpose="run_actions">
      <params>
        <param name="Station" />
      </params>
      <actions>
        <run_actions ref="md.FDN_Core.Charter_Fee" result="$Info">
          <param name="Station" value="$Station" />
        </run_actions>
        <do_if value="$Info.$Macro == ''">
          <return value="table[$Ok = false, $Reason = 'no qualifying dock or pier', $Info = $Info]" />
        </do_if>
        <do_if value="not $Info.$Allowed">
          <run_actions ref="md.FDN_Core.Cfg_Get" result="$MinSt">
            <param name="Key" value="'CharterMinStanding'" />
          </run_actions>
          <return value="table[$Ok = false, $Reason = 'standing too low with %1 (have %2, need %3)'.[(if $Info.$Faction then $Info.$Faction.knownname else '?'), $Info.$Standing, $MinSt], $Info = $Info]" />
        </do_if>
        <do_if value="player.money lt $Info.$Fee">
          <return value="table[$Ok = false, $Reason = 'not enough money (need %1 Cr, have %2 Cr)'.[$Info.$Fee.formatted.default, player.money.formatted.default], $Info = $Info]" />
        </do_if>
        <return value="table[$Ok = true, $Reason = '', $Info = $Info]" />
      </actions>
    </library>

    <!-- Card X4-14b: player clicked 'buy charter'. Re-checks everything, then charges and records the charter. -->
    <cue name="On_Buy_Charter" instantiate="true">
      <conditions>
        <event_cue_signalled />
      </conditions>
      <actions>
        <do_if value="md.FDN_Core.Init.$Defaults? and event.param.$object?">
          <set_value name="$Station" exact="event.param.$object" />
          <set_value name="$Name" exact="'unknown station'" />
          <set_value name="$Reason" exact="''" />
          <do_if value="$Station == null or not $Station.exists or not $Station.isclass.station or not $Station.isplayerowned">
            <set_value name="$Reason" exact="'the station is gone or not yours'" />
          </do_if>
          <do_else>
            <set_value name="$Name" exact="$Station.knownname" />
            <run_actions ref="md.FDN_Core.Charter_Get" result="$Ch">
              <param name="Station" value="$Station" />
            </run_actions>
            <do_if value="$Ch != null">
              <set_value name="$Reason" exact="'a charter is already active'" />
            </do_if>
            <do_else>
              <run_actions ref="md.FDN_Menu.Charter_Check" result="$Chk">
                <param name="Station" value="$Station" />
              </run_actions>
              <do_if value="not $Chk.$Ok">
                <set_value name="$Reason" exact="$Chk.$Reason" />
              </do_if>
              <do_else>
                <set_value name="$Info" exact="$Chk.$Info" />
                <set_value name="$Fee" exact="$Info.$Fee" />
                <set_value name="$Before" exact="player.money" />
                <transfer_money from="faction.player" to="faction.ownerless" amount="$Fee" comment="proven in game (charter purchases): player account to the money sink, as FDN fees (Start_Transfer, Undo_Fee)" />
                <set_value name="$Taken" exact="$Before - player.money" comment="what really left the account; the game rounds to whole credits" />
                <do_if value="$Taken lt $Fee - 1Cr">
                  <do_if value="player.money lt $Before">
                    <transfer_money from="faction.ownerless" to="faction.player" amount="$Before - player.money" />
                  </do_if>
                  <set_value name="$Reason" exact="'payment of %1 Cr was not taken (taken %2 Cr), nothing charged'.[$Fee.formatted.default, $Taken.formatted.default]" />
                </do_if>
                <do_else>
                  <run_actions ref="md.FDN_Core.Charter_Set" result="$Set">
                    <param name="Station" value="$Station" />
                    <param name="Fee" value="$Taken" />
                    <param name="Dock" value="$Info.$Macro" />
                    <param name="Faction" value="$Info.$Faction" />
                    <param name="Standing" value="$Info.$Standing" />
                    <param name="Source" value="' (menu purchase)'" />
                  </run_actions>
                  <do_if value="not $Set">
                    <transfer_money from="faction.ownerless" to="faction.player" amount="$Taken" />
                    <set_value name="$Reason" exact="'the charter could not be recorded, payment refunded'" />
                  </do_if>
                  <do_else>
                    <set_value name="$FName" exact="(if $Info.$Faction then $Info.$Faction.knownname else '?')" />
                    <run_actions ref="md.FDN_Core.Log">
                      <param name="Level" value="2" />
                      <param name="Text" value="'CHARTER BOUGHT: %1, paid %2 Cr (base %3 Cr, discount %4 pct), dock %5, standing %6 with %7, player money now %8 Cr'.[$Name, $Taken.formatted.default, $Info.$Base.formatted.default, $Info.$Discount, $Info.$Macro, $Info.$Standing, $FName, player.money.formatted.default]" />
                    </run_actions>
                    <run_actions ref="md.FDN_Core.Logbook_Event">
                      <param name="Tier" value="'notice'" />
                      <param name="Category" value="'general'" />
                      <param name="Title" value="'charter bought for %1'.[$Name]" />
                      <param name="Text" value="'FDN charter bought for %1 for %2 Cr (standing %3 with %4, %5 pct discount). The station becomes a Distribution Centre on the next FDN pass.'.[$Name, $Taken.formatted.default, $Info.$Standing, $FName, $Info.$Discount]" />
                      <param name="Money" value="$Taken" />
                      <param name="Object" value="$Station" />
                    </run_actions>
                  </do_else>
                </do_else>
              </do_else>
            </do_else>
          </do_else>
          <do_if value="$Reason != ''">
            <run_actions ref="md.FDN_Core.Log">
              <param name="Level" value="2" />
              <param name="Text" value="'CHARTER REFUSED: %1, %2 (menu)'.[$Name, $Reason]" />
            </run_actions>
            <run_actions ref="md.FDN_Core.Logbook_Event">
              <param name="Tier" value="'problem'" />
              <param name="Title" value="'charter refused at %1'.[$Name]" />
              <param name="Text" value="'FDN charter not bought for %1: %2. Nothing was charged.'.[$Name, $Reason]" />
              <param name="Object" value="(if $Station != null and $Station.exists then $Station else null)" />
            </run_actions>
          </do_if>
        </do_if>
      </actions>
    </cue>

    <!-- Card X4-14c: player clicked 'revoke charter'. Ends it at once, no refund (md.FDN_Core.Charter_End logs it). -->
    <cue name="On_Revoke_Charter" instantiate="true">
      <conditions>
        <event_cue_signalled />
      </conditions>
      <actions>
        <do_if value="md.FDN_Core.Init.$Defaults? and event.param.$object?">
          <set_value name="$Station" exact="event.param.$object" />
          <set_value name="$Done" exact="false" />
          <set_value name="$Name" exact="'unknown station'" />
          <do_if value="$Station != null and $Station.exists">
            <set_value name="$Name" exact="$Station.knownname" />
            <run_actions ref="md.FDN_Core.Charter_End" result="$Done">
              <param name="Station" value="$Station" />
              <param name="Reason" value="'revoked from the station menu'" />
              <param name="Revoke" value="true" />
            </run_actions>
          </do_if>
          <do_if value="not $Done">
            <run_actions ref="md.FDN_Core.Log">
              <param name="Level" value="2" />
              <param name="Text" value="'CHARTER REVOKE FAILED: %1 has no charter or is gone (menu)'.[$Name]" />
            </run_actions>
            <run_actions ref="md.FDN_Core.Logbook_Event">
              <param name="Tier" value="'problem'" />
              <param name="Title" value="'charter not revoked at %1'.[$Name]" />
              <param name="Text" value="'FDN charter for %1 not revoked: the station has no charter or is gone.'.[$Name]" />
            </run_actions>
          </do_if>
        </do_if>
      </actions>
    </cue>

    <!-- Player picked an entry. event.param = table[$id, $echo (setting key), $object (station), ...] -->
    <cue name="On_Toggle" instantiate="true">
      <conditions>
        <event_cue_signalled />
      </conditions>
      <actions>
        <do_if value="md.FDN_Core.Init.$Defaults? and event.param.$echo? and event.param.$object?">
          <set_value name="$Station" exact="event.param.$object" />
          <set_value name="$Key" exact="event.param.$echo" />
          <set_value name="$Ok" exact="false" />
          <set_value name="$Name" exact="'unknown station'" />
          <do_if value="$Station != null and $Station.exists">
            <set_value name="$Name" exact="$Station.knownname" />
            <run_actions ref="md.FDN_Core.Station_Cfg_Get" result="$Cur">
              <param name="Station" value="$Station" />
              <param name="Key" value="$Key" />
            </run_actions>
            <set_value name="$New" exact="1" />
            <do_if value="$Cur == 1">
              <set_value name="$New" exact="0" />
            </do_if>
            <run_actions ref="md.FDN_Core.Station_Cfg_Set" result="$Ok">
              <param name="Station" value="$Station" />
              <param name="Key" value="$Key" />
              <param name="Value" value="$New" />
              <param name="Source" value="' (menu)'" />
            </run_actions>
          </do_if>
          <do_if value="$Ok">
            <set_value name="$Word" exact="'OFF'" />
            <do_if value="$New == 1">
              <set_value name="$Word" exact="'ON'" />
            </do_if>
            <run_actions ref="md.FDN_Core.Logbook_Event">
              <param name="Tier" value="'info'" />
              <param name="Category" value="'general'" />
              <param name="Title" value="'%1 %2 at %3'.[$Key, $Word, $Name]" />
              <param name="Text" value="'Station setting %1 at %2 turned %3 from the station menu.'.[$Key, $Name, $Word]" />
              <param name="Object" value="$Station" />
            </run_actions>
          </do_if>
          <do_else>
            <run_actions ref="md.FDN_Core.Log">
              <param name="Level" value="2" />
              <param name="Text" value="'station setting %1 at %2 not changed (menu)'.[$Key, $Name]" />
            </run_actions>
            <run_actions ref="md.FDN_Core.Logbook_Event">
              <param name="Tier" value="'problem'" />
              <param name="Title" value="'station setting not changed'" />
              <param name="Text" value="'Station setting %1 at %2 could not be changed: the station is gone or the setting is not known.'.[$Key, $Name]" />
            </run_actions>
          </do_else>
        </do_if>
      </actions>
    </cue>

    <!-- The station entries, in display order. Keys are per-station settings in md.FDN_Core (flags 0/1) -->
    <library name="Entry_List">
      <actions>
        <set_value name="$List" exact="[]" />
        <append_to_list name="$List" exact="table[$Key = 'ResourcesFdnManaged', $Label = 'resource supply', $Mouseover = 'FDN delivers the resources this station needs']" />
        <append_to_list name="$List" exact="table[$Key = 'ProductsFdnManaged', $Label = 'send products to DC', $Mouseover = 'The products of this station are moved to the nearest Distribution Centre']" />
      </actions>
    </library>
  </cues>
</mdscript>