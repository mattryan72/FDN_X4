<?xml version="1.0" encoding="utf-8"?>
<mdscript name="FDN_Supply" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="md.xsd">
  <cues>
    <!--
      Step 5: polling skeleton. Every PollInterval seconds, purge the registry then walk
      PollStationsPerPass stations (round robin) so the whole list is covered over several passes.
      Each visited station is scanned read-only (step 6, Scan_Station) and its shortfalls ranked (step 7, Rank_Shortfalls).
      The poll is the safety net for stalled modules; production-finished events are the main trigger.
    -->
    <cue name="Start" version="1" checktime="5s" checkinterval="5s">
      <conditions>
        <cue_is_complete cue="md.Setup.GameStart" />
      </conditions>
      <actions>
        <set_value name="$Index" exact="1" comment="round-robin position in the registry list" />
        <set_value name="$Interval" exact="60" />
      </actions>
      <cues>
        <cue name="Loop">
          <actions>
            <set_value name="$Reg" exact="md.FDN_Stations.Registry" />
            <do_if value="$Reg.$Stations?">
              <run_actions ref="md.FDN_Stations.Purge" />
              <run_actions ref="md.FDN_Core.Claim_Purge" />
              <!-- Step 9b: deliver delayed transfers that are due (only used when TransferDelay is 1) -->
              <run_actions ref="md.FDN_Supply.Process_Pending" />

              <!-- Step 9a, read-only: find DCs and build networks once per pass -->
              <run_actions ref="md.FDN_Supply.Find_DCs" result="$DCs" />
              <run_actions ref="md.FDN_Core.Cfg_Get" result="$NetRange">
                <param name="Key" value="'DCNetworkRange'" />
              </run_actions>
              <run_actions ref="md.FDN_Supply.Build_Networks" result="$Networks">
                <param name="DCs" value="$DCs" />
                <param name="Range" value="$NetRange" />
              </run_actions>

              <run_actions ref="md.FDN_Core.Cfg_Get" result="$PerPass">
                <param name="Key" value="'PollStationsPerPass'" />
              </run_actions>
              <run_actions ref="md.FDN_Core.Cfg_Get" result="$NewInterval">
                <param name="Key" value="'PollInterval'" />
              </run_actions>
              <do_if value="$NewInterval and $NewInterval ge 5">
                <set_value name="$Interval" exact="$NewInterval" />
              </do_if>

              <set_value name="$Count" exact="$Reg.$Stations.count" />
              <do_if value="$Count gt 0">
                <do_if value="$Index gt $Count">
                  <set_value name="$Index" exact="1" />
                </do_if>
                <set_value name="$Visit" exact="[[$PerPass, 1].max, $Count].min" />
                <run_actions ref="md.FDN_Core.Log">
                  <param name="Level" value="4" />
                  <param name="Text" value="'poll pass: %1 of %2 stations, starting at %3'.[$Visit, $Count, $Index]" />
                </run_actions>
                <do_all exact="$Visit" counter="$n">
                  <set_value name="$Station" exact="$Reg.$Stations.{$Index}" />
                  <run_actions ref="md.FDN_Core.Log">
                    <param name="Level" value="4" />
                    <param name="Text" value="'poll visit: %1 (%2)'.[$Station.knownname, $Station]" />
                  </run_actions>
                  <run_actions ref="md.FDN_Supply.Nearest_DC" result="$Near">
                    <param name="Station" value="$Station" />
                    <param name="DCs" value="$DCs" />
                  </run_actions>
                  <do_if value="$Near.{2} ge 0">
                    <run_actions ref="md.FDN_Core.Log">
                      <param name="Level" value="3" />
                      <param name="Text" value="'nearest DC for %1: %2, %3 jumps'.[$Station.knownname, $Near.{1}.knownname, $Near.{2}]" />
                    </run_actions>
                  </do_if>
                  <do_else>
                    <run_actions ref="md.FDN_Core.Log">
                      <param name="Level" value="3" />
                      <param name="Text" value="'nearest DC for %1: none in range'.[$Station.knownname]" />
                    </run_actions>
                  </do_else>
                  <run_actions ref="md.FDN_Supply.Scan_Station">
                    <param name="Station" value="$Station" />
                  </run_actions>
                  <run_actions ref="md.FDN_Supply.Rank_Shortfalls" result="$Ranked">
                    <param name="Station" value="$Station" />
                  </run_actions>
                  <!-- Step 9b: supply the ranked needs from DCs in range -->
                  <do_if value="$Ranked.count gt 0 and $DCs.count gt 0">
                    <run_actions ref="md.FDN_Supply.Supply_Station">
                      <param name="Station" value="$Station" />
                      <param name="DCs" value="$DCs" />
                      <param name="Networks" value="$Networks" />
                      <param name="Ranked" value="$Ranked" />
                    </run_actions>
                  </do_if>
                  <set_value name="$Index" operation="add" />
                  <do_if value="$Index gt $Count">
                    <set_value name="$Index" exact="1" />
                  </do_if>
                </do_all>
              </do_if>
            </do_if>
          </actions>
          <cues>
            <cue name="Reset">
              <delay exact="$Interval * 1s" comment="VERIFY: delay accepts a parent variable and a time expression like this" />
              <actions>
                <reset_cue cue="Loop" />
              </actions>
            </cue>
          </cues>
        </cue>
      </cues>
    </cue>

    <!--
      Step 6, read-only. Logs the state of every operational production module on a station.
      For a module that is waiting for resources, logs each resource the station holds less of than one
      production cycle needs. Changes nothing.
      Properties used: .iswaitingforresources .iswaitingforstorage .isproducing .ispaused .products .resources
      (all from scriptproperties.xml), ware.resources.{$res}.count (amount per cycle, as in factionsubgoal_buildstation.xml),
      station.cargo.{$ware}.count.
    -->
    <library name="Scan_Station" purpose="run_actions">
      <params>
        <param name="Station" />
      </params>
      <actions>
        <do_if value="not $Station.exists">
          <return />
        </do_if>
        <find_object_component object="$Station" name="$Modules" class="class.production" checkoperational="true" multiple="true" />
        <do_all exact="$Modules.count" counter="$m">
          <set_value name="$Module" exact="$Modules.{$m}" />
          <do_if value="$Module.iswaitingforresources">
            <run_actions ref="md.FDN_Core.Log">
              <param name="Level" value="3" />
              <param name="Text" value="'STALLED (resources): %1, module %2, makes %3'.[$Station.knownname, $Module.knownname, $Module.products.list]" />
            </run_actions>
            <set_value name="$Products" exact="$Module.products.list" />
            <do_all exact="$Products.count" counter="$p">
              <set_value name="$Product" exact="$Products.{$p}" />
              <set_value name="$Resources" exact="$Product.resources.list" comment="ware.resources is the default production method recipe (confirmed in scriptproperties.xml). VERIFY: race-specific methods can differ, see ware.raceresources" />
              <do_all exact="$Resources.count" counter="$r">
                <set_value name="$Resource" exact="$Resources.{$r}" />
                <set_value name="$Need" exact="$Product.resources.{$Resource}.count" />
                <set_value name="$Have" exact="$Station.cargo.{$Resource}.count" />
                <do_if value="$Have lt $Need">
                  <run_actions ref="md.FDN_Core.Log">
                    <param name="Level" value="3" />
                    <param name="Text" value="'  missing %1: need %2 per cycle, station has %3'.[$Resource.name, $Need, $Have]" />
                  </run_actions>
                </do_if>
              </do_all>
            </do_all>
          </do_if>
          <do_elseif value="$Module.iswaitingforstorage">
            <run_actions ref="md.FDN_Core.Log">
              <param name="Level" value="3" />
              <param name="Text" value="'STALLED (output full): %1, module %2'.[$Station.knownname, $Module.knownname]" />
            </run_actions>
          </do_elseif>
          <do_else>
            <run_actions ref="md.FDN_Core.Log">
              <param name="Level" value="4" />
              <param name="Text" value="'ok: %1, module %2, producing %3, paused %4'.[$Station.knownname, $Module.knownname, $Module.isproducing, $Module.ispaused]" />
            </run_actions>
          </do_else>
        </do_all>
      </actions>
    </library>
    <!--
      Step 9a, read-only. Distribution Centre (DC) detection.
      A player station is a DC when it has an operational dock area or pier whose macro id is in the DCMacros setting.
      Returns the list of DC stations. Uses component .macro.id (as vanilla npc_state_machines.xml) and list .indexof.
      VERIFY: the three trade-station modules are class.dockarea or class.pier, and checkoperational works for them.
    -->
    <library name="Find_DCs" purpose="run_actions">
      <actions>
        <set_value name="$DCs" exact="[]" />
        <run_actions ref="md.FDN_Core.Cfg_Get" result="$Macros">
          <param name="Key" value="'DCMacros'" />
        </run_actions>
        <set_value name="$Reg" exact="md.FDN_Stations.Registry" />
        <do_if value="not $Macros or not $Reg.$Stations?">
          <return value="$DCs" />
        </do_if>
        <do_for_each name="$S" in="$Reg.$Stations">
          <do_if value="$S.exists">
            <find_object_component object="$S" name="$Docks" class="[class.dockarea, class.pier]" checkoperational="true" multiple="true" />
            <set_value name="$Marker" exact="null" />
            <do_for_each name="$D" in="$Docks">
              <do_if value="not $Marker and $Macros.indexof.{$D.macro.id}">
                <set_value name="$Marker" exact="$D" />
              </do_if>
            </do_for_each>
            <do_if value="$Marker">
              <append_to_list name="$DCs" exact="$S" />
              <run_actions ref="md.FDN_Core.Log">
                <param name="Level" value="3" />
                <param name="Text" value="'DC: %1, marker %2'.[$S.knownname, $Marker.macro.id]" />
              </run_actions>
            </do_if>
          </do_if>
        </do_for_each>
        <run_actions ref="md.FDN_Core.Log">
          <param name="Level" value="3" />
          <param name="Text" value="'DCs found: %1'.[$DCs.count]" />
        </run_actions>
        <return value="$DCs" />
      </actions>
    </library>

    <!--
      Step 9a, read-only. Groups DCs into networks. Two DCs are linked when 0 le gatedistance le Range;
      a network is every DC reachable through links (flood fill). A DC with no link is a network of one.
      Returns a list of networks, each a list of DC stations. gatedistance is -1 when there is no route.
      VERIFY: append_to_list with a list value adds it as one element (list of lists).
    -->
    <library name="Build_Networks" purpose="run_actions">
      <params>
        <param name="DCs" />
        <param name="Range" default="10" />
      </params>
      <actions>
        <set_value name="$Networks" exact="[]" />
        <set_value name="$Done" exact="[]" />
        <do_all exact="$DCs.count" counter="$i">
          <set_value name="$Seed" exact="$DCs.{$i}" />
          <do_if value="not $Done.indexof.{$Seed}">
            <set_value name="$Net" exact="[$Seed]" />
            <append_to_list name="$Done" exact="$Seed" />
            <set_value name="$q" exact="1" />
            <do_while value="$q le $Net.count">
              <set_value name="$Cur" exact="$Net.{$q}" />
              <do_all exact="$DCs.count" counter="$j">
                <set_value name="$Other" exact="$DCs.{$j}" />
                <do_if value="not $Done.indexof.{$Other}">
                  <set_value name="$Jumps" exact="$Cur.gatedistance.{$Other}" />
                  <do_if value="$Jumps ge 0 and $Jumps le $Range">
                    <append_to_list name="$Net" exact="$Other" />
                    <append_to_list name="$Done" exact="$Other" />
                  </do_if>
                </do_if>
              </do_all>
              <set_value name="$q" operation="add" />
            </do_while>
            <append_to_list name="$Networks" exact="$Net" />
            <run_actions ref="md.FDN_Core.Log">
              <param name="Level" value="3" />
              <param name="Text" value="'DC network %1: %2 DC(s), first %3'.[$Networks.count, $Net.count, $Net.{1}.knownname]" />
            </run_actions>
            <do_all exact="$Net.count" counter="$k">
              <run_actions ref="md.FDN_Core.Log">
                <param name="Level" value="4" />
                <param name="Text" value="'  network %1 member: %2'.[$Networks.count, $Net.{$k}.knownname]" />
              </run_actions>
            </do_all>
          </do_if>
        </do_all>
        <return value="$Networks" />
      </actions>
    </library>

    <!--
      Step 9a, read-only. Nearest DC to a station, by gate jumps, within the station's range
      (RangeLimit / RangeMaxJumps, read per station with Station_Cfg_Get). A DC serves itself at 0 jumps.
      Returns [DC, jumps]; [null, -1] means no DC in range.
      VERIFY: two stations in the same sector give gatedistance 0.
    -->
    <library name="Nearest_DC" purpose="run_actions">
      <params>
        <param name="Station" />
        <param name="DCs" />
      </params>
      <actions>
        <set_value name="$Best" exact="null" />
        <set_value name="$BestJumps" exact="-1" />
        <do_if value="not $Station.exists">
          <return value="[$Best, $BestJumps]" />
        </do_if>
        <run_actions ref="md.FDN_Core.Station_Cfg_Get" result="$Limit">
          <param name="Station" value="$Station" />
          <param name="Key" value="'RangeLimit'" />
        </run_actions>
        <run_actions ref="md.FDN_Core.Station_Cfg_Get" result="$MaxJumps">
          <param name="Station" value="$Station" />
          <param name="Key" value="'RangeMaxJumps'" />
        </run_actions>
        <do_all exact="$DCs.count" counter="$i">
          <set_value name="$DC" exact="$DCs.{$i}" />
          <do_if value="$DC == $Station">
            <set_value name="$Jumps" exact="0" />
          </do_if>
          <do_else>
            <set_value name="$Jumps" exact="$Station.gatedistance.{$DC}" />
          </do_else>
          <do_if value="$Jumps ge 0 and (not $Limit or $Jumps le $MaxJumps) and ($BestJumps lt 0 or $Jumps lt $BestJumps)">
            <set_value name="$Best" exact="$DC" />
            <set_value name="$BestJumps" exact="$Jumps" />
          </do_if>
        </do_all>
        <return value="[$Best, $BestJumps]" />
      </actions>
    </library>

    <!--
      Step 9a, read-only. Cycle-based need for one station (replaces the step 7 target-stock logic).
      required(w) = sum over operational production modules and their products of resources-per-cycle(w) x CyclesToCover
      need(w)     = required(w) - cargo.{w}.count - Claim_Get(w). Only wares with need gt 0 are returned.
      Returns table ware -> [need, required]. Empty when ResourcesFdnManaged is 0 or CyclesToCover le 0.
      CyclesToCover and ResourcesFdnManaged are read per station (Station_Cfg_Get). Never fills storage.
      Recipe: ware.resources = default production method. VERIFY: race-specific methods (ware.raceresources) can differ.
    -->
    <library name="Calc_Need" purpose="run_actions">
      <params>
        <param name="Station" />
      </params>
      <actions>
        <set_value name="$Out" exact="table[]" />
        <do_if value="not $Station.exists">
          <return value="$Out" />
        </do_if>
        <run_actions ref="md.FDN_Core.Station_Cfg_Get" result="$Managed">
          <param name="Station" value="$Station" />
          <param name="Key" value="'ResourcesFdnManaged'" />
        </run_actions>
        <run_actions ref="md.FDN_Core.Station_Cfg_Get" result="$Cycles">
          <param name="Station" value="$Station" />
          <param name="Key" value="'CyclesToCover'" />
        </run_actions>
        <do_if value="not $Managed or not ($Cycles gt 0)">
          <run_actions ref="md.FDN_Core.Log">
            <param name="Level" value="4" />
            <param name="Text" value="'need: %1 skipped (ResourcesFdnManaged %2, CyclesToCover %3)'.[$Station.knownname, $Managed, $Cycles]" />
          </run_actions>
          <return value="$Out" />
        </do_if>
        <set_value name="$Req" exact="table[]" comment="ware -> required amount" />
        <find_object_component object="$Station" name="$Modules" class="class.production" checkoperational="true" multiple="true" />
        <do_all exact="$Modules.count" counter="$m">
          <set_value name="$Products" exact="$Modules.{$m}.products.list" />
          <do_all exact="$Products.count" counter="$p">
            <set_value name="$Product" exact="$Products.{$p}" />
            <set_value name="$Resources" exact="$Product.resources.list" />
            <do_all exact="$Resources.count" counter="$r">
              <set_value name="$Resource" exact="$Resources.{$r}" />
              <set_value name="$PerCycle" exact="$Product.resources.{$Resource}.count * $Cycles" />
              <do_if value="$Req.{$Resource}?">
                <set_value name="$Req.{$Resource}" exact="$Req.{$Resource} + $PerCycle" />
              </do_if>
              <do_else>
                <set_value name="$Req.{$Resource}" exact="$PerCycle" />
              </do_else>
            </do_all>
          </do_all>
        </do_all>
        <set_value name="$Keys" exact="$Req.keys.list" />
        <do_all exact="$Keys.count" counter="$k">
          <set_value name="$Ware" exact="$Keys.{$k}" />
          <run_actions ref="md.FDN_Core.Claim_Get" result="$Claimed">
            <param name="Station" value="$Station" />
            <param name="Ware" value="$Ware" />
          </run_actions>
          <set_value name="$Need" exact="$Req.{$Ware} - $Station.cargo.{$Ware}.count - $Claimed" />
          <do_if value="$Need gt 0">
            <set_value name="$Out.{$Ware}" exact="[$Need, $Req.{$Ware}]" />
          </do_if>
        </do_all>
        <return value="$Out" />
      </actions>
    </library>

    <!--
      Step 7, rewritten in step 9a, read-only. Ranks the station's cycle-based needs (Calc_Need), emptiest first:
      score = stock * 100 / required. Logs each need and returns the ranked ware list.
      Properties used: station.cargo.{$ware}.count, table .keys.sorted (sorted by value, ascending).
    -->
    <library name="Rank_Shortfalls" purpose="run_actions">
      <params>
        <param name="Station" />
      </params>
      <actions>
        <set_value name="$Ranked" exact="[]" />
        <do_if value="not $Station.exists">
          <return value="$Ranked" />
        </do_if>
        <run_actions ref="md.FDN_Supply.Calc_Need" result="$Needs">
          <param name="Station" value="$Station" />
        </run_actions>
        <run_actions ref="md.FDN_Core.Station_Cfg_Get" result="$Cycles">
          <param name="Station" value="$Station" />
          <param name="Key" value="'CyclesToCover'" />
        </run_actions>
        <set_value name="$Score" exact="table[]" comment="ware -> stock percent of required" />
        <set_value name="$Keys" exact="$Needs.keys.list" />
        <do_all exact="$Keys.count" counter="$k">
          <set_value name="$Ware" exact="$Keys.{$k}" />
          <set_value name="$Score.{$Ware}" exact="($Station.cargo.{$Ware}.count * 100) / [$Needs.{$Ware}.{2}, 1].max" />
        </do_all>
        <do_if value="$Score.keys.count gt 0">
          <set_value name="$Ranked" exact="$Score.keys.sorted" />
          <do_all exact="$Ranked.count" counter="$k">
            <set_value name="$Ware" exact="$Ranked.{$k}" />
            <run_actions ref="md.FDN_Core.Claim_Get" result="$Claimed">
              <param name="Station" value="$Station" />
              <param name="Ware" value="$Ware" />
            </run_actions>
            <run_actions ref="md.FDN_Core.Log">
              <param name="Level" value="3" />
              <param name="Text" value="'NEED #%1: %2, %3, need %4 for %5 cycle(s) (required %6, stock %7 = %8 pct, claimed %9)'.[$k, $Station.knownname, $Ware.name, $Needs.{$Ware}.{1}, $Cycles, $Needs.{$Ware}.{2}, $Station.cargo.{$Ware}.count, $Score.{$Ware}, $Claimed]" />
            </run_actions>
          </do_all>
        </do_if>
        <return value="$Ranked" />
      </actions>
    </library>

    <!--
      Step 9b. DCs that may supply a station, nearest first.
      Order (Matt's design): the nearest DC in range, then the other DCs of that DC's network that are also in range.
      A DC never supplies itself, and own non-DC stations are never sources (TransferOwn is ignored).
      Range per station: RangeLimit / RangeMaxJumps (Station_Cfg_Get), same rule as Nearest_DC.
      Returns a list of [DC, jumps].
      VERIFY: two stations in the same sector give gatedistance 0.
    -->
    <library name="Candidate_DCs" purpose="run_actions">
      <params>
        <param name="Station" />
        <param name="DCs" />
        <param name="Networks" />
      </params>
      <actions>
        <set_value name="$Out" exact="[]" />
        <run_actions ref="md.FDN_Core.Station_Cfg_Get" result="$Limit">
          <param name="Station" value="$Station" />
          <param name="Key" value="'RangeLimit'" />
        </run_actions>
        <run_actions ref="md.FDN_Core.Station_Cfg_Get" result="$MaxJumps">
          <param name="Station" value="$Station" />
          <param name="Key" value="'RangeMaxJumps'" />
        </run_actions>
        <set_value name="$InRange" exact="table[]" comment="DC -> jumps, only DCs in range and not the station itself" />
        <do_all exact="$DCs.count" counter="$i">
          <set_value name="$DC" exact="$DCs.{$i}" />
          <do_if value="$DC.exists and $DC != $Station">
            <set_value name="$Jumps" exact="$Station.gatedistance.{$DC}" />
            <do_if value="$Jumps ge 0 and (not $Limit or $Jumps le $MaxJumps)">
              <set_value name="$InRange.{$DC}" exact="$Jumps" />
            </do_if>
          </do_if>
        </do_all>
        <do_if value="$InRange.keys.count == 0">
          <return value="$Out" />
        </do_if>
        <set_value name="$Sorted" exact="$InRange.keys.sorted" comment="sorted by jumps, nearest first (keys.sorted proven in Rank_Shortfalls)" />
        <set_value name="$First" exact="$Sorted.{1}" />
        <set_value name="$Net" exact="[$First]" />
        <do_for_each name="$N" in="$Networks">
          <do_if value="$N.indexof.{$First}">
            <set_value name="$Net" exact="$N" />
          </do_if>
        </do_for_each>
        <do_all exact="$Sorted.count" counter="$s">
          <set_value name="$DC" exact="$Sorted.{$s}" />
          <do_if value="$Net.indexof.{$DC}">
            <append_to_list name="$Out" exact="[$DC, $InRange.{$DC}]" />
          </do_if>
        </do_all>
        <return value="$Out" />
      </actions>
    </library>

    <!--
      Step 9b. Supplies one station's ranked needs from its candidate DCs.
      For each ware, emptiest first:
        available = DC stock - reserve, reserve = DC stock x keep / 100 rounded up,
                    keep = DCKeepWare.{ware} if set, else DCKeepPercent.
                    (Choice: reserve is a percent of the DC's current STOCK, not of its storage capacity, because
                    capacity is shared per transport type and has no clean per-ware value.)
        qty       = min(need still open, available, free space for the ware at the station)
        fee       = averageprice x qty x TransferFeePercent / 100 x (1 + jumps x FeeRangeMult) x FeeVolumeMult x FeeTypeMult
      The DC pays. Skips are logged (WARN) and written to the logbook (throttled by LogbookSkipInterval).
    -->
    <library name="Supply_Station" purpose="run_actions">
      <params>
        <param name="Station" />
        <param name="DCs" />
        <param name="Networks" />
        <param name="Ranked" />
      </params>
      <actions>
        <do_if value="not $Station.exists">
          <return />
        </do_if>
        <run_actions ref="md.FDN_Supply.Candidate_DCs" result="$Cands">
          <param name="Station" value="$Station" />
          <param name="DCs" value="$DCs" />
          <param name="Networks" value="$Networks" />
        </run_actions>
        <do_if value="$Cands.count == 0">
          <run_actions ref="md.FDN_Core.Log">
            <param name="Level" value="4" />
            <param name="Text" value="'supply: %1 has no other DC in range'.[$Station.knownname]" />
          </run_actions>
          <return />
        </do_if>
        <run_actions ref="md.FDN_Supply.Calc_Need" result="$Needs">
          <param name="Station" value="$Station" />
        </run_actions>
        <run_actions ref="md.FDN_Core.Cfg_Get" result="$Pct">
          <param name="Key" value="'TransferFeePercent'" />
        </run_actions>
        <run_actions ref="md.FDN_Core.Cfg_Get" result="$RangeMult">
          <param name="Key" value="'FeeRangeMult'" />
        </run_actions>
        <run_actions ref="md.FDN_Core.Cfg_Get" result="$VolMult">
          <param name="Key" value="'FeeVolumeMult'" />
        </run_actions>
        <run_actions ref="md.FDN_Core.Cfg_Get" result="$TypeMult">
          <param name="Key" value="'FeeTypeMult'" />
        </run_actions>
        <run_actions ref="md.FDN_Core.Cfg_Get" result="$KeepPct">
          <param name="Key" value="'DCKeepPercent'" />
        </run_actions>
        <run_actions ref="md.FDN_Core.Cfg_Get" result="$KeepTbl">
          <param name="Key" value="'DCKeepWare'" />
        </run_actions>
        <do_all exact="$Ranked.count" counter="$w">
          <set_value name="$Ware" exact="$Ranked.{$w}" />
          <do_if value="$Needs.{$Ware}?">
            <set_value name="$Left" exact="$Needs.{$Ware}.{1}" />
            <set_value name="$Moved" exact="0" />
            <set_value name="$Reason" exact="'no DC in range has spare stock'" />
            <do_all exact="$Cands.count" counter="$c">
              <do_if value="$Left gt 0">
                <set_value name="$DC" exact="$Cands.{$c}.{1}" />
                <set_value name="$Jumps" exact="$Cands.{$c}.{2}" />
                <set_value name="$Keep" exact="$KeepPct" />
                <do_if value="$KeepTbl and $KeepTbl.{$Ware}?" comment="VERIFY: a table setting read through Cfg_Get keeps ware keys">
                  <set_value name="$Keep" exact="$KeepTbl.{$Ware}" />
                </do_if>
                <set_value name="$Stock" exact="$DC.cargo.{$Ware}.count" />
                <set_value name="$Reserve" exact="($Stock * $Keep + 99) / 100" comment="integer maths, rounds up. VERIFY: integer division truncates" />
                <set_value name="$Avail" exact="$Stock - $Reserve" />
                <set_value name="$Free" exact="$Station.cargo.{$Ware}.free" comment="VERIFY: per-ware free amount (used like this in vanilla aiscripts)" />
                <set_value name="$Qty" exact="[$Left, $Avail, $Free].min" />
                <do_if value="$Free le 0">
                  <set_value name="$Reason" exact="'station has no free storage for it'" />
                </do_if>
                <do_if value="$Qty gt 0">
                  <set_value name="$Fee" exact="($Ware.averageprice * $Qty * $Pct * (1.0 + $Jumps * $RangeMult) * $VolMult * $TypeMult) / 100" comment="VERIFY: money x float stays money; averageprice is type money (scriptproperties)" />
                  <do_if value="$Fee lt 0Cr">
                    <set_value name="$Fee" exact="0Cr" />
                  </do_if>
                  <do_if value="$DC.money lt $Fee">
                    <set_value name="$Reason" exact="'DC %1 cannot pay the fee (%2 needed, %3 in account)'.[$DC.knownname, $Fee, $DC.money]" />
                  </do_if>
                  <do_else>
                    <run_actions ref="md.FDN_Supply.Start_Transfer" result="$Ok">
                      <param name="DC" value="$DC" />
                      <param name="Station" value="$Station" />
                      <param name="Ware" value="$Ware" />
                      <param name="Qty" value="$Qty" />
                      <param name="Fee" value="$Fee" />
                      <param name="Jumps" value="$Jumps" />
                    </run_actions>
                    <do_if value="$Ok">
                      <set_value name="$Left" exact="$Left - $Qty" />
                      <set_value name="$Moved" exact="$Moved + $Qty" />
                    </do_if>
                    <do_else>
                      <set_value name="$Reason" exact="'transfer from %1 failed and was refunded'.[$DC.knownname]" />
                    </do_else>
                  </do_else>
                </do_if>
              </do_if>
            </do_all>
            <do_if value="$Moved == 0">
              <run_actions ref="md.FDN_Supply.Skip_Report">
                <param name="Station" value="$Station" />
                <param name="Ware" value="$Ware" />
                <param name="Need" value="$Needs.{$Ware}.{1}" />
                <param name="Reason" value="$Reason" />
              </run_actions>
            </do_if>
          </do_if>
        </do_all>
      </actions>
    </library>

    <!--
      Step 9b. All-or-nothing start of one transfer. Order: fee, claim, take the cargo out of the DC.
      Then delivers at once (TransferDelay 0) or queues it (TransferDelay 1, jumps x TransferDelayMult seconds).
      Fee: transfer_money from the DC station's account to faction.ownerless (the money sink vanilla diplomacy.xml uses;
      vanilla lib_generic.xml uses a station as 'from'). On any failure everything done so far is undone and the fee refunded.
      Returns true when the cargo left the DC.
    -->
    <library name="Start_Transfer" purpose="run_actions">
      <params>
        <param name="DC" />
        <param name="Station" />
        <param name="Ware" />
        <param name="Qty" />
        <param name="Fee" />
        <param name="Jumps" />
      </params>
      <actions>
        <set_value name="$Before" exact="$DC.money" />
        <do_if value="$Fee gt 0Cr">
          <transfer_money from="$DC" to="faction.ownerless" amount="$Fee" comment="VERIFY: fee leaves the DC account" />
          <do_if value="$DC.money gt $Before - $Fee">
            <run_actions ref="md.FDN_Core.Log">
              <param name="Level" value="2" />
              <param name="Text" value="'fee not taken from DC %1 (before %2, now %3, fee %4); transfer cancelled'.[$DC.knownname, $Before, $DC.money, $Fee]" />
            </run_actions>
            <do_if value="$DC.money lt $Before">
              <transfer_money from="faction.ownerless" to="$DC" amount="$Before - $DC.money" />
            </do_if>
            <return value="false" />
          </do_if>
        </do_if>
        <run_actions ref="md.FDN_Core.Claim_Add">
          <param name="Station" value="$Station" />
          <param name="Ware" value="$Ware" />
          <param name="Amount" value="$Qty" />
        </run_actions>
        <remove_cargo object="$DC" ware="$Ware" exact="$Qty" result="$Removed" comment="VERIFY: result is the amount removed" />
        <do_if value="$Removed lt $Qty">
          <do_if value="$Removed gt 0">
            <add_cargo object="$DC" ware="$Ware" exact="$Removed" />
          </do_if>
          <run_actions ref="md.FDN_Supply.Undo_Fee">
            <param name="DC" value="$DC" />
            <param name="Fee" value="$Fee" />
          </run_actions>
          <run_actions ref="md.FDN_Core.Claim_Release">
            <param name="Station" value="$Station" />
            <param name="Ware" value="$Ware" />
            <param name="Amount" value="$Qty" />
          </run_actions>
          <run_actions ref="md.FDN_Core.Log">
            <param name="Level" value="2" />
            <param name="Text" value="'could not take %1 %2 from DC %3 (got %4); put back and fee refunded'.[$Qty, $Ware.name, $DC.knownname, $Removed]" />
          </run_actions>
          <return value="false" />
        </do_if>
        <run_actions ref="md.FDN_Core.Cfg_Get" result="$Delay">
          <param name="Key" value="'TransferDelay'" />
        </run_actions>
        <do_if value="$Delay">
          <run_actions ref="md.FDN_Core.Cfg_Get" result="$DelayMult">
            <param name="Key" value="'TransferDelayMult'" />
          </run_actions>
          <set_value name="$Init" exact="md.FDN_Core.Init" />
          <do_if value="not $Init.$Pending?">
            <set_value name="$Init.$Pending" exact="[]" />
          </do_if>
          <set_value name="$Due" exact="player.age + $Jumps * $DelayMult" />
          <append_to_list name="$Init.$Pending" exact="[$Due, $DC, $Station, $Ware, $Qty, $Fee, $Jumps]" />
          <run_actions ref="md.FDN_Core.Log">
            <param name="Level" value="3" />
            <param name="Text" value="'QUEUED: %1 %2 from DC %3 to %4, %5 jumps, fee %6, due in %7 s'.[$Qty, $Ware.name, $DC.knownname, $Station.knownname, $Jumps, $Fee, $Jumps * $DelayMult]" />
          </run_actions>
          <return value="true" />
        </do_if>
        <run_actions ref="md.FDN_Supply.Deliver" result="$Ok">
          <param name="DC" value="$DC" />
          <param name="Station" value="$Station" />
          <param name="Ware" value="$Ware" />
          <param name="Qty" value="$Qty" />
          <param name="Fee" value="$Fee" />
          <param name="Jumps" value="$Jumps" />
        </run_actions>
        <return value="$Ok" />
      </actions>
    </library>

    <!--
      Step 9b. Puts the cargo (already taken from the DC) into the station. On failure the cargo goes back to the DC,
      the fee is refunded and the claim released. On success the claim is released and a ledger entry added.
    -->
    <library name="Deliver" purpose="run_actions">
      <params>
        <param name="DC" />
        <param name="Station" />
        <param name="Ware" />
        <param name="Qty" />
        <param name="Fee" />
        <param name="Jumps" />
      </params>
      <actions>
        <set_value name="$Added" exact="0" />
        <do_if value="$Station.exists and $Station.owner == faction.player">
          <add_cargo object="$Station" ware="$Ware" exact="$Qty" result="$Added" comment="VERIFY: result is the amount added" />
        </do_if>
        <run_actions ref="md.FDN_Core.Claim_Release">
          <param name="Station" value="$Station" />
          <param name="Ware" value="$Ware" />
          <param name="Amount" value="$Qty" />
        </run_actions>
        <do_if value="$Added lt $Qty">
          <do_if value="$Added gt 0">
            <remove_cargo object="$Station" ware="$Ware" exact="$Added" />
          </do_if>
          <do_if value="$DC.exists">
            <add_cargo object="$DC" ware="$Ware" exact="$Qty" />
          </do_if>
          <run_actions ref="md.FDN_Supply.Undo_Fee">
            <param name="DC" value="$DC" />
            <param name="Fee" value="$Fee" />
          </run_actions>
          <run_actions ref="md.FDN_Supply.Skip_Report">
            <param name="Station" value="$Station" />
            <param name="Ware" value="$Ware" />
            <param name="Need" value="$Qty" />
            <param name="Reason" value="'delivery failed (station gone or full), cargo returned to DC and fee refunded'" />
          </run_actions>
          <return value="false" />
        </do_if>
        <run_actions ref="md.FDN_Supply.Ledger_Add">
          <param name="DC" value="$DC" />
          <param name="Entry" value="[player.age, $Station, $Ware, $Qty, $Fee, $Jumps]" />
        </run_actions>
        <run_actions ref="md.FDN_Core.Log">
          <param name="Level" value="3" />
          <param name="Text" value="'TRANSFER: %1 %2 from DC %3 to %4, %5 jumps, fee %6'.[$Qty, $Ware.name, $DC.knownname, $Station.knownname, $Jumps, $Fee]" />
        </run_actions>
        <return value="true" />
      </actions>
    </library>

    <!-- Step 9b. Refunds a fee to the DC (to the player's own account if the DC is gone). -->
    <library name="Undo_Fee" purpose="run_actions">
      <params>
        <param name="DC" />
        <param name="Fee" />
      </params>
      <actions>
        <do_if value="$Fee gt 0Cr">
          <do_if value="$DC.exists">
            <transfer_money from="faction.ownerless" to="$DC" amount="$Fee" />
          </do_if>
          <do_else>
            <transfer_money from="faction.ownerless" to="faction.player" amount="$Fee" />
          </do_else>
          <run_actions ref="md.FDN_Core.Log">
            <param name="Level" value="2" />
            <param name="Text" value="'fee %1 refunded'.[$Fee]" />
          </run_actions>
        </do_if>
      </actions>
    </library>

    <!--
      Step 9b. Delivers queued transfers whose time has come (TransferDelay 1). Runs at the start of each poll pass,
      so delivery can be up to PollInterval seconds late. Choice: a saved list checked by the poll is simpler and
      safer across save/load than one delayed cue per transfer.
    -->
    <library name="Process_Pending" purpose="run_actions">
      <actions>
        <set_value name="$Init" exact="md.FDN_Core.Init" />
        <do_if value="not $Init.$Pending?">
          <return />
        </do_if>
        <do_if value="$Init.$Pending.count == 0">
          <return />
        </do_if>
        <set_value name="$Keep" exact="[]" />
        <set_value name="$All" exact="$Init.$Pending" />
        <set_value name="$Init.$Pending" exact="[]" />
        <do_all exact="$All.count" counter="$i">
          <set_value name="$E" exact="$All.{$i}" />
          <do_if value="player.age ge $E.{1}">
            <run_actions ref="md.FDN_Supply.Deliver">
              <param name="DC" value="$E.{2}" />
              <param name="Station" value="$E.{3}" />
              <param name="Ware" value="$E.{4}" />
              <param name="Qty" value="$E.{5}" />
              <param name="Fee" value="$E.{6}" />
              <param name="Jumps" value="$E.{7}" />
            </run_actions>
          </do_if>
          <do_else>
            <append_to_list name="$Keep" exact="$E" />
          </do_else>
        </do_all>
        <do_all exact="$Keep.count" counter="$k">
          <append_to_list name="$Init.$Pending" exact="$Keep.{$k}" />
        </do_all>
      </actions>
    </library>

    <!--
      Step 9b. Supply ledger, saved in md.FDN_Core.Init.$Ledger: DC -> list of [time, station, ware, qty, fee, jumps].
      Oldest entries are dropped above LedgerMax per DC.
      VERIFY: a station object works as a table key (same open point as $Claims).
    -->
    <library name="Ledger_Add" purpose="run_actions">
      <params>
        <param name="DC" />
        <param name="Entry" />
      </params>
      <actions>
        <set_value name="$Init" exact="md.FDN_Core.Init" />
        <do_if value="not $Init.$Ledger?">
          <set_value name="$Init.$Ledger" exact="table[]" />
        </do_if>
        <do_if value="not $Init.$Ledger.{$DC}?">
          <set_value name="$Init.$Ledger.{$DC}" exact="[]" />
        </do_if>
        <append_to_list name="$Init.$Ledger.{$DC}" exact="$Entry" />
        <run_actions ref="md.FDN_Core.Cfg_Get" result="$Max">
          <param name="Key" value="'LedgerMax'" />
        </run_actions>
        <do_while value="$Max gt 0 and $Init.$Ledger.{$DC}.count gt $Max">
          <remove_value name="$Init.$Ledger.{$DC}.{1}" comment="removes the oldest entry (vanilla uses remove_value on list index 1)" />
        </do_while>
        <run_actions ref="md.FDN_Core.Log">
          <param name="Level" value="4" />
          <param name="Text" value="'ledger: DC %1 now has %2 entries'.[$DC.knownname, $Init.$Ledger.{$DC}.count]" />
        </run_actions>
      </actions>
    </library>

    <!--
      Step 9b. Reports a skipped (or failed) supply: always a WARN log line, plus a logbook entry the player can see.
      The logbook entry for the same station and ware is written at most once per LogbookSkipInterval seconds,
      remembered in $Station.$fdn_skiplog (ware -> time), so a long shortage does not flood the logbook.
    -->
    <library name="Skip_Report" purpose="run_actions">
      <params>
        <param name="Station" />
        <param name="Ware" />
        <param name="Need" />
        <param name="Reason" />
      </params>
      <actions>
        <run_actions ref="md.FDN_Core.Log">
          <param name="Level" value="2" />
          <param name="Text" value="'SKIP: %1, %2 (need %3): %4'.[$Station.knownname, $Ware.name, $Need, $Reason]" />
        </run_actions>
        <do_if value="not $Station.exists">
          <return />
        </do_if>
        <run_actions ref="md.FDN_Core.Cfg_Get" result="$Gap">
          <param name="Key" value="'LogbookSkipInterval'" />
        </run_actions>
        <do_if value="not $Station.$fdn_skiplog?">
          <set_value name="$Station.$fdn_skiplog" exact="table[]" />
        </do_if>
        <do_if value="$Station.$fdn_skiplog.{$Ware}?">
          <do_if value="player.age lt $Station.$fdn_skiplog.{$Ware} + $Gap">
            <return />
          </do_if>
        </do_if>
        <set_value name="$Station.$fdn_skiplog.{$Ware}" exact="player.age" />
        <write_to_logbook category="upkeep" title="'FDN: supply skipped at %1'.[$Station.knownname]" text="'%1 (need %2): %3'.[$Ware.name, $Need, $Reason]" interaction="showonmap" object="$Station" comment="VERIFY: text attribute shows under the title, as in vanilla diplomacy.xml" />
      </actions>
    </library>

  </cues>
</mdscript>
