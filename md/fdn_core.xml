<?xml version="1.0" encoding="utf-8"?>
<mdscript name="FDN_Core" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="md.xsd">
  <cues>
    <!--
      X4-09a-fix VERIFY: '@' prefixes were removed where combined with '?' (game rejects that).
      Behaviour of '?' when an intermediate key/variable is missing (e.g. $Init.$Claims.{$Station}.{$Ware}?)
      is to be confirmed in the next debug log (look for new errors on those lines).
    -->
    <!--
      Persistent root cue. Its variables are saved with the game.
      $Overrides : table of settings the player has changed (saved). Empty means "all defaults".
      $Claims    : saved table of reserved ware amounts, station -> ware -> amount (see Claim_* libraries).
      $Defaults  : table of built-in defaults. NOT meant to be saved long-term: it is rebuilt on
                   every load (see OnLoad) so new settings added in updates appear in old saves.
      Read a setting from any file with run_actions ref="md.FDN_Core.Cfg_Get" (see below).
    -->
    <cue name="Init" version="3">
      <conditions>
        <!-- X4-09a-fix: also start on game load, so saves that began before FDN was added get set up.
             VERIFY: the 'Failed to set table[].<Key>' errors in the 9a log are believed (not confirmed)
             to come from Init never having run on Matt's existing save; check the next log. -->
        <check_any>
          <event_cue_signalled cue="md.Setup.Start" />
          <event_game_loaded />
        </check_any>
      </conditions>
      <actions>
        <!-- Only create the saved tables if they do not exist yet -->
        <do_if value="not $Overrides?">
          <set_value name="$Overrides" exact="table[]" />
        </do_if>
        <do_if value="not $Claims?">
          <set_value name="$Claims" exact="table[]" />
        </do_if>
        <include_actions ref="Cfg_LoadDefaults" />
        <run_actions ref="md.FDN_Core.Log">
          <param name="Level" value="3" />
          <param name="Text" value="'core loaded, version 1.0.0 (step 9b), %1 default settings'.[$Defaults.keys.count]" />
        </run_actions>
      </actions>
      <patch sinceversion="2">
        <!-- Saves made with version 1 had no config tables -->
        <set_value name="$Overrides" exact="table[]" />
        <include_actions ref="Cfg_LoadDefaults" />
      </patch>
      <patch sinceversion="3">
        <!-- Saves made with version 2 had no claims table -->
        <set_value name="$Claims" exact="table[]" />
      </patch>
      <cues>
        <!-- Rebuild defaults on every load so settings added by newer versions get their default. -->
        <cue name="OnLoad" instantiate="true">
          <conditions>
            <!-- Only fires after a save has been loaded (same as vanilla drain_stations.xml) -->
            <event_game_loaded />
          </conditions>
          <actions>
            <include_actions ref="Cfg_LoadDefaults" />
            <run_actions ref="md.FDN_Core.Log">
              <param name="Level" value="3" />
              <param name="Text" value="'defaults loaded on game load, %1 settings, %2 overridden'.[$Defaults.keys.count, $Overrides.keys.count]" />
            </run_actions>
          </actions>
        </cue>

        <!--
          DEFAULTS TABLE. To add a setting: add ONE set_value line in the right group below.
          Key names are strings and MUST start with '$' (X4 rejects table string keys without it,
          proven by the 9a-diag log). Callers pass plain names; Cfg_Get / Station_Cfg_* add the '$'. Flags are 0/1. Times are in seconds. Do not rename keys later
          (saved overrides use the key name).
        -->
        <library name="Cfg_LoadDefaults" purpose="include_actions">
          <actions>
            <set_value name="$Defaults" exact="table[]" />

            <!-- ===== General / logging (step 3) ===== -->
            <set_value name="$Defaults.{'$DebugLog'}" exact="1" comment="1 = write FDN debug lines to the game log" />
            <set_value name="$Defaults.{'$LogLevel'}" exact="3" comment="1 = errors, 2 = +warnings, 3 = +info, 4 = +debug detail" />

            <!-- ===== Polling (step 5) ===== -->
            <set_value name="$Defaults.{'$PollInterval'}" exact="60" comment="seconds between supply passes" />
            <set_value name="$Defaults.{'$PollStationsPerPass'}" exact="3" comment="how many stations each supply pass looks at" />

            <!-- ===== Own-station transfers (step 9) ===== -->
            <set_value name="$Defaults.{'$TransferOwn'}" exact="0" comment="IGNORED from card 9b: own stations are never sources. Kept so old saves keep the key" />
            <set_value name="$Defaults.{'$TransferFeePercent'}" exact="2" comment="fee as percent of transfer value (Matt: 2 is OK as a placeholder)" />
            <set_value name="$Defaults.{'$TransferDelay'}" exact="0" comment="1 = delay transfers by gate distance. Instant when 0" />
            <set_value name="$Defaults.{'$TransferDelayMult'}" exact="8" comment="seconds of delay per gate jump (Matt: start at 8)" />
            <set_value name="$Defaults.{'$RangeLimit'}" exact="1" comment="1 = only use stations within RangeMaxJumps gate jumps. 0 = no distance limit" />
            <set_value name="$Defaults.{'$RangeMaxJumps'}" exact="5" comment="max gate jumps when RangeLimit is on. Minimum 1, no upper maximum" />

            <!-- ===== NPC fallback (step 10) ===== -->
            <set_value name="$Defaults.{'$NpcFallback'}" exact="0" comment="1 = buy shortfalls from NPC offers when no own station can cover. OFF until tested" />

            <!-- ===== Distribution Centres (step 9) ===== -->
            <set_value name="$Defaults.{'$DCMacros'}" exact="['dockarea_arg_m_02_tradestation_01_macro', 'pier_bor_tradestation_01_macro', 'pier_ter_tradestation_01_macro']" comment="macro ids of marker modules: a player station with one of these is a DC (Argon trade dock, Boron and Terran trade piers)" />
            <set_value name="$Defaults.{'$DCNetworkRange'}" exact="10" comment="max gate jumps between two DCs for them to join one network" />
            <set_value name="$Defaults.{'$DCKeepPercent'}" exact="10" comment="percent of each ware a DC always keeps (used from card 9b)" />
            <set_value name="$Defaults.{'$DCKeepWare'}" exact="table[]" comment="per-ware keep percent override, ware -> percent (used from card 9b)" />
            <set_value name="$Defaults.{'$LedgerMax'}" exact="200" comment="max ledger entries kept per DC (used from card 9b)" />
            <set_value name="$Defaults.{'$FeeRangeMult'}" exact="0.2" comment="fee range factor: fee x (1 + jumps x this). Default 0.2 (3 jumps = 1.6x base). Decimals allowed" />
            <set_value name="$Defaults.{'$FeeVolumeMult'}" exact="1.0" comment="fee volume factor, flat for now. Decimals allowed" />
            <set_value name="$Defaults.{'$FeeTypeMult'}" exact="1.0" comment="fee ware-type factor, flat for now. Decimals allowed" />
            <set_value name="$Defaults.{'$LogbookSkipInterval'}" exact="600" comment="seconds before the same skipped station and ware is written to the logbook again" />

            <!-- ===== Station-side settings (step 9, each can be overridden per station with Station_Cfg_Set) ===== -->
            <set_value name="$Defaults.{'$CyclesToCover'}" exact="1" comment="production cycles of resources FDN supplies ahead" />
            <set_value name="$Defaults.{'$ResourcesFdnManaged'}" exact="1" comment="1 = FDN supplies this station's resources" />
            <set_value name="$Defaults.{'$ProductsFdnManaged'}" exact="1" comment="1 = this station's products go to its nearest DC (card 9c)" />
            <set_value name="$Defaults.{'$ProductMinBatch'}" exact="100" comment="card 9c: smallest amount of a product sent to the DC in one go" />
            <set_value name="$Defaults.{'$ProductKeepWare'}" exact="table[]" comment="card 9c: per-ware amount a station keeps of its own product, ware -> amount. Empty = keep 0" />
          </actions>
        </library>

      </cues>
    </cue>

    <!--
      Read a setting from any FDN file:
        <run_actions ref="md.FDN_Core.Cfg_Get" result="$Value">
          <param name="Key" value="'TransferOwn'" />
        </run_actions>
      Override wins, then default, else null.
    -->
    <library name="Cfg_Get" purpose="run_actions">
      <params>
        <param name="Key" />
      </params>
      <actions>
        <set_value name="$Init" exact="md.FDN_Core.Init" />
        <set_value name="$K" exact="'$' + $Key" comment="X4-09a-fix2: table string keys must start with $" />
        <do_if value="$Init.$Overrides.{$K}?">
          <return value="$Init.$Overrides.{$K}" />
        </do_if>
        <do_elseif value="$Init.$Defaults.{$K}?">
          <return value="$Init.$Defaults.{$K}" />
        </do_elseif>
        <return value="null" />
      </actions>
    </library>

    <!--
      Write a log line from any FDN file:
        <run_actions ref="md.FDN_Core.Log">
          <param name="Level" value="3" />
          <param name="Text" value="'something happened'" />
        </run_actions>
      Levels: 1 error (always logged), 2 warning, 3 info, 4 debug detail.
      Lines 2-4 are written only when DebugLog = 1 and Level is at or below LogLevel.
      Note: debug_text output only reaches the log when X4 runs with -debug and -logfile.
    -->
    <library name="Log" purpose="run_actions">
      <params>
        <param name="Level" default="3" />
        <param name="Text" />
      </params>
      <actions>
        <set_value name="$Prefix" exact="'FDN INFO'" />
        <do_if value="$Level le 1"><set_value name="$Prefix" exact="'FDN ERROR'" /></do_if>
        <do_elseif value="$Level == 2"><set_value name="$Prefix" exact="'FDN WARN'" /></do_elseif>
        <do_elseif value="$Level ge 4"><set_value name="$Prefix" exact="'FDN DEBUG'" /></do_elseif>
        <do_if value="$Level le 1">
          <debug_text text="player.age + ' ' + $Prefix + ' ' + $Text" filter="general" />
          <return />
        </do_if>
        <run_actions ref="md.FDN_Core.Cfg_Get" result="$Enabled">
          <param name="Key" value="'DebugLog'" />
        </run_actions>
        <do_if value="$Enabled">
          <run_actions ref="md.FDN_Core.Cfg_Get" result="$MaxLevel">
            <param name="Key" value="'LogLevel'" />
          </run_actions>
          <do_if value="$Level le $MaxLevel">
            <debug_text text="player.age + ' ' + $Prefix + ' ' + $Text" filter="general" />
          </do_if>
        </do_if>
      </actions>
    </library>
    <!--
      PER-STATION SETTINGS (step 8). A station may carry its own table $Station.$fdn_cfg holding overrides
      of any key in the defaults table. Lookup order: station table, then player override, then default.
      The table lives on the station object, so it goes away when the station is destroyed.
        Station_Cfg_Get   params Station, Key        returns the effective value
        Station_Cfg_Set   params Station, Key, Value creates the table if needed, writes the key
        Station_Cfg_Reset params Station, Key        removes one key. Leave Key out (null) to remove the whole table
      Station_Cfg_Setup creates an empty table on the station if it has none.
    -->
    <library name="Station_Cfg_Setup" purpose="run_actions">
      <params>
        <param name="Station" />
      </params>
      <actions>
        <do_if value="$Station.exists and not $Station.$fdn_cfg?">
          <set_value name="$Station.$fdn_cfg" exact="table[]" />
        </do_if>
      </actions>
    </library>

    <library name="Station_Cfg_Get" purpose="run_actions">
      <params>
        <param name="Station" />
        <param name="Key" />
      </params>
      <actions>
        <set_value name="$K" exact="'$' + $Key" comment="X4-09a-fix2: table string keys must start with $" />
        <do_if value="$Station.$fdn_cfg.{$K}?">
          <return value="$Station.$fdn_cfg.{$K}" />
        </do_if>
        <!-- Cfg_Get adds the $ itself, so pass the plain name -->
        <run_actions ref="md.FDN_Core.Cfg_Get" result="$Value">
          <param name="Key" value="$Key" />
        </run_actions>
        <return value="$Value" />
      </actions>
    </library>

    <library name="Station_Cfg_Set" purpose="run_actions">
      <params>
        <param name="Station" />
        <param name="Key" />
        <param name="Value" />
      </params>
      <actions>
        <do_if value="not $Station.exists">
          <return />
        </do_if>
        <run_actions ref="md.FDN_Core.Station_Cfg_Setup">
          <param name="Station" value="$Station" />
        </run_actions>
        <set_value name="$K" exact="'$' + $Key" comment="X4-09a-fix2: table string keys must start with $" />
        <set_value name="$Station.$fdn_cfg.{$K}" exact="$Value" />
      </actions>
    </library>

    <library name="Station_Cfg_Reset" purpose="run_actions">
      <params>
        <param name="Station" />
        <param name="Key" default="null" />
      </params>
      <actions>
        <do_if value="not $Station.exists or not $Station.$fdn_cfg?">
          <return />
        </do_if>
        <do_if value="$Key == null">
          <remove_value name="$Station.$fdn_cfg" />
        </do_if>
        <do_else>
          <set_value name="$K" exact="'$' + $Key" comment="X4-09a-fix2: table string keys must start with $" />
          <remove_value name="$Station.$fdn_cfg.{$K}" />
        </do_else>
      </actions>
    </library>

    <!--
      CLAIMS / LOCK (step 8). A claim reserves an amount of a ware at a station so two transfers
      (or a transfer and an NPC buy) do not use the same stock or fill the same gap twice.
      Stored in md.FDN_Core.Init.$Claims as station -> ware -> amount.
        Claim_Get     params Station, Ware          returns the amount currently claimed
        Claim_Add     params Station, Ware, Amount  adds to the claim (Amount must be above 0)
        Claim_Release params Station, Ware, Amount  subtracts, never below 0, removes empty entries
        Claim_Purge   no params                     drops claims for stations that no longer exist
      Nothing makes a claim yet. Step 9 will, when it queues a transfer.
    -->
    <library name="Claim_Get" purpose="run_actions">
      <params>
        <param name="Station" />
        <param name="Ware" />
      </params>
      <actions>
        <set_value name="$Init" exact="md.FDN_Core.Init" />
        <do_if value="$Init.$Claims.{$Station}.{$Ware}?">
          <return value="$Init.$Claims.{$Station}.{$Ware}" />
        </do_if>
        <return value="0" />
      </actions>
    </library>

    <library name="Claim_Add" purpose="run_actions">
      <params>
        <param name="Station" />
        <param name="Ware" />
        <param name="Amount" />
      </params>
      <actions>
        <do_if value="$Amount le 0">
          <return />
        </do_if>
        <set_value name="$Init" exact="md.FDN_Core.Init" />
        <do_if value="not $Init.$Claims.{$Station}?">
          <set_value name="$Init.$Claims.{$Station}" exact="table[]" comment="VERIFY: a station object works as a table key and nested tables can be written like this" />
        </do_if>
        <set_value name="$Current" exact="0" />
        <do_if value="$Init.$Claims.{$Station}.{$Ware}?">
          <set_value name="$Current" exact="$Init.$Claims.{$Station}.{$Ware}" />
        </do_if>
        <set_value name="$Init.$Claims.{$Station}.{$Ware}" exact="$Current + $Amount" />
        <run_actions ref="md.FDN_Core.Log">
          <param name="Level" value="4" />
          <param name="Text" value="'claim +%1 %2 at %3, now %4'.[$Amount, $Ware.name, $Station.knownname, $Current + $Amount]" />
        </run_actions>
      </actions>
    </library>

    <library name="Claim_Release" purpose="run_actions">
      <params>
        <param name="Station" />
        <param name="Ware" />
        <param name="Amount" />
      </params>
      <actions>
        <set_value name="$Init" exact="md.FDN_Core.Init" />
        <do_if value="not $Init.$Claims.{$Station}.{$Ware}?">
          <return />
        </do_if>
        <set_value name="$Left" exact="$Init.$Claims.{$Station}.{$Ware} - $Amount" />
        <do_if value="$Left gt 0">
          <set_value name="$Init.$Claims.{$Station}.{$Ware}" exact="$Left" />
        </do_if>
        <do_else>
          <remove_value name="$Init.$Claims.{$Station}.{$Ware}" />
          <do_if value="$Init.$Claims.{$Station}.keys.count == 0">
            <remove_value name="$Init.$Claims.{$Station}" />
          </do_if>
        </do_else>
        <run_actions ref="md.FDN_Core.Log">
          <param name="Level" value="4" />
          <param name="Text" value="'claim -%1 %2 at %3, left %4'.[$Amount, $Ware.name, $Station.knownname, [$Left, 0].max]" />
        </run_actions>
      </actions>
    </library>

    <library name="Claim_Purge" purpose="run_actions">
      <actions>
        <set_value name="$Init" exact="md.FDN_Core.Init" />
        <do_if value="not $Init.$Claims?">
          <return />
        </do_if>
        <set_value name="$Keys" exact="$Init.$Claims.keys.list" />
        <do_all exact="$Keys.count" counter="$k">
          <do_if value="not $Keys.{$k}.exists">
            <remove_value name="$Init.$Claims.{$Keys.{$k}}" />
          </do_if>
        </do_all>
      </actions>
    </library>

  </cues>
</mdscript>