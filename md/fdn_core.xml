<?xml version="1.0" encoding="utf-8"?>
<mdscript name="FDN_Core" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="md.xsd">
  <cues>
    <!--
      Persistent root cue. Its variables are saved with the game.
      $Overrides : table of settings the player has changed (saved). Empty means "all defaults".
      $Defaults  : table of built-in defaults. NOT meant to be saved long-term: it is rebuilt on
                   every load (see OnLoad) so new settings added in updates appear in old saves.
      Read a setting from any file with run_actions ref="md.FDN_Core.Cfg_Get" (see below).
    -->
    <cue name="Init" version="2">
      <conditions>
        <event_cue_signalled cue="md.Setup.Start" />
      </conditions>
      <actions>
        <set_value name="$Overrides" exact="table[]" />
        <include_actions ref="Cfg_LoadDefaults" />
        <run_actions ref="md.FDN_Core.Log">
          <param name="Level" value="3" />
          <param name="Text" value="'core loaded, version 1.0.0 (step 3), %1 default settings'.[$Defaults.keys.list.count]" />
        </run_actions>
      </actions>
      <patch sinceversion="2">
        <!-- Saves made with version 1 had no config tables -->
        <set_value name="$Overrides" exact="table[]" />
        <include_actions ref="Cfg_LoadDefaults" />
      </patch>
      <cues>
        <!-- Rebuild defaults on every load so settings added by newer versions get their default. -->
        <cue name="OnLoad" instantiate="true">
          <conditions>
            <!-- Only fires after a save has been loaded (same as vanilla drain_stations.xml) -->
            <event_game_loaded />
          </conditions>
          <actions>
            <include_actions ref="Cfg_LoadDefaults" />
            <run_actions ref="md.FDN_Core.Log">
              <param name="Level" value="4" />
              <param name="Text" value="'defaults reloaded, %1 settings, %2 overridden'.[$Defaults.keys.list.count, $Overrides.keys.list.count]" />
            </run_actions>
          </actions>
        </cue>

        <!--
          DEFAULTS TABLE. To add a setting: add ONE set_value line in the right group below.
          Key names are strings. Flags are 0/1. Times are in seconds. Do not rename keys later
          (saved overrides use the key name).
        -->
        <library name="Cfg_LoadDefaults" purpose="include_actions">
          <actions>
            <set_value name="$Defaults" exact="table[]" />

            <!-- ===== General / logging (step 3) ===== -->
            <set_value name="$Defaults.{'DebugLog'}" exact="1" comment="1 = write FDN debug lines to the game log" />
            <set_value name="$Defaults.{'LogLevel'}" exact="3" comment="1 = errors, 2 = +warnings, 3 = +info, 4 = +debug detail" />

            <!-- ===== Polling (step 5) ===== -->
            <set_value name="$Defaults.{'PollInterval'}" exact="60" comment="seconds between supply passes" />

            <!-- ===== Own-station transfers (step 9) ===== -->
            <set_value name="$Defaults.{'TransferOwn'}" exact="0" comment="1 = move wares between own stations. OFF until tested" />
            <set_value name="$Defaults.{'TransferFeePercent'}" exact="2" comment="fee as percent of transfer value (Matt: 2 is OK as a placeholder)" />
            <set_value name="$Defaults.{'TransferDelay'}" exact="0" comment="1 = delay transfers by gate distance. Instant when 0" />
            <set_value name="$Defaults.{'TransferDelayMult'}" exact="8" comment="seconds of delay per gate jump (Matt: start at 8)" />
            <set_value name="$Defaults.{'RangeLimit'}" exact="1" comment="1 = only use stations within RangeMaxJumps gate jumps. 0 = no distance limit" />
            <set_value name="$Defaults.{'RangeMaxJumps'}" exact="5" comment="max gate jumps when RangeLimit is on. Minimum 1, no upper maximum" />

            <!-- ===== NPC fallback (step 10) ===== -->
            <set_value name="$Defaults.{'NpcFallback'}" exact="0" comment="1 = buy shortfalls from NPC offers when no own station can cover. OFF until tested" />
          </actions>
        </library>

      </cues>
    </cue>

    <!--
      Read a setting from any FDN file:
        <run_actions ref="md.FDN_Core.Cfg_Get" result="$Value">
          <param name="Key" value="'TransferOwn'" />
        </run_actions>
      Override wins, then default, else null.
    -->
    <library name="Cfg_Get" purpose="run_actions">
      <params>
        <param name="Key" />
      </params>
      <actions>
        <set_value name="$Init" exact="md.FDN_Core.Init" />
        <do_if value="@$Init.$Overrides.{$Key}?">
          <return value="$Init.$Overrides.{$Key}" />
        </do_if>
        <do_elseif value="@$Init.$Defaults.{$Key}?">
          <return value="$Init.$Defaults.{$Key}" />
        </do_elseif>
        <return value="null" />
      </actions>
    </library>

    <!--
      Write a log line from any FDN file:
        <run_actions ref="md.FDN_Core.Log">
          <param name="Level" value="3" />
          <param name="Text" value="'something happened'" />
        </run_actions>
      Levels: 1 error (always logged), 2 warning, 3 info, 4 debug detail.
      Lines 2-4 are written only when DebugLog = 1 and Level is at or below LogLevel.
      Note: debug_text output only reaches the log when X4 runs with -debug and -logfile.
    -->
    <library name="Log" purpose="run_actions">
      <params>
        <param name="Level" default="3" />
        <param name="Text" />
      </params>
      <actions>
        <set_value name="$Prefix" exact="'FDN INFO'" />
        <do_if value="$Level le 1"><set_value name="$Prefix" exact="'FDN ERROR'" /></do_if>
        <do_elseif value="$Level == 2"><set_value name="$Prefix" exact="'FDN WARN'" /></do_elseif>
        <do_elseif value="$Level ge 4"><set_value name="$Prefix" exact="'FDN DEBUG'" /></do_elseif>
        <do_if value="$Level le 1">
          <debug_text text="player.age + ' ' + $Prefix + ' ' + $Text" filter="general" />
          <return />
        </do_if>
        <run_actions ref="md.FDN_Core.Cfg_Get" result="$Enabled">
          <param name="Key" value="'DebugLog'" />
        </run_actions>
        <do_if value="$Enabled">
          <run_actions ref="md.FDN_Core.Cfg_Get" result="$MaxLevel">
            <param name="Key" value="'LogLevel'" />
          </run_actions>
          <do_if value="$Level le $MaxLevel">
            <debug_text text="player.age + ' ' + $Prefix + ' ' + $Text" filter="general" />
          </do_if>
        </do_if>
      </actions>
    </library>
  </cues>
</mdscript>