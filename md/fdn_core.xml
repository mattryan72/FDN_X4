<?xml version="1.0" encoding="utf-8"?>
<mdscript name="FDN_Core" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="md.xsd">
  <cues>
    <!--
      X4-09a-fix VERIFY: '@' prefixes were removed where combined with '?' (game rejects that).
      Behaviour of '?' when an intermediate key/variable is missing (e.g. $Init.$Claims.{$Station}.{$Ware}?)
      is to be confirmed in the next debug log (look for new errors on those lines).
    -->
    <!--
      Persistent root cue. Its variables are saved with the game.
      $Overrides : table of settings the player has changed (saved). Empty means "all defaults".
      $StationCfg: saved table of per-station overrides, station -> key -> value (card 10a, created on first use).
      $Claims    : saved table of reserved ware amounts, station -> ware -> amount (see Claim_* libraries).
      $Defaults  : table of built-in defaults. NOT meant to be saved long-term: it is rebuilt on
                   every load (see OnLoad) so new settings added in updates appear in old saves.
      Read a setting from any file with run_actions ref="md.FDN_Core.Cfg_Get" (see below).
    -->
    <cue name="Init" version="3">
      <conditions>
        <!-- X4-09a-fix: also start on game load, so saves that began before FDN was added get set up.
             VERIFY: the 'Failed to set table[].<Key>' errors in the 9a log are believed (not confirmed)
             to come from Init never having run on Matt's existing save; check the next log. -->
        <check_any>
          <event_cue_signalled cue="md.Setup.Start" />
          <event_game_loaded />
        </check_any>
      </conditions>
      <actions>
        <!-- Only create the saved tables if they do not exist yet -->
        <do_if value="not $Overrides?">
          <set_value name="$Overrides" exact="table[]" />
        </do_if>
        <do_if value="not $Claims?">
          <set_value name="$Claims" exact="table[]" />
        </do_if>
        <include_actions ref="Cfg_LoadDefaults" />
        <run_actions ref="md.FDN_Core.Log">
          <param name="Level" value="3" />
          <param name="Text" value="'core loaded, version 1.0.0 (step 9b), %1 default settings'.[$Defaults.keys.count]" />
        </run_actions>
      </actions>
      <patch sinceversion="2">
        <!-- Saves made with version 1 had no config tables -->
        <set_value name="$Overrides" exact="table[]" />
        <include_actions ref="Cfg_LoadDefaults" />
      </patch>
      <patch sinceversion="3">
        <!-- Saves made with version 2 had no claims table -->
        <set_value name="$Claims" exact="table[]" />
      </patch>
      <cues>
        <!-- Rebuild defaults on every load so settings added by newer versions get their default. -->
        <cue name="OnLoad" instantiate="true">
          <conditions>
            <!-- Only fires after a save has been loaded (same as vanilla drain_stations.xml) -->
            <event_game_loaded />
          </conditions>
          <actions>
            <include_actions ref="Cfg_LoadDefaults" />
            <run_actions ref="md.FDN_Core.Log">
              <param name="Level" value="3" />
              <param name="Text" value="'defaults loaded on game load, %1 settings, %2 overridden'.[$Defaults.keys.count, $Overrides.keys.count]" />
            </run_actions>
          </actions>
        </cue>

        <!--
          DEFAULTS TABLE. To add a setting: add ONE set_value line in the right group below.
          Key names are strings and MUST start with '$' (X4 rejects table string keys without it,
          proven by the 9a test log). Callers pass plain names; Cfg_Get / Station_Cfg_* add the '$'. Flags are 0/1. Times are in seconds. Do not rename keys later
          (saved overrides use the key name).
        -->
        <library name="Cfg_LoadDefaults" purpose="include_actions">
          <actions>
            <set_value name="$Defaults" exact="table[]" />

            <!-- ===== General / logging (step 3) ===== -->
            <set_value name="$Defaults.{'$DebugLog'}" exact="1" comment="1 = write FDN debug lines to the game log" />
            <set_value name="$Defaults.{'$LogLevel'}" exact="3" comment="1 = errors, 2 = +warnings, 3 = +info, 4 = +debug detail" />

            <!-- ===== Polling (step 5) ===== -->
            <set_value name="$Defaults.{'$PollInterval'}" exact="60" comment="seconds between supply passes" />
            <set_value name="$Defaults.{'$PollStationsPerPass'}" exact="3" comment="how many stations each supply pass looks at" />

            <!-- ===== Own-station transfers (step 9) ===== -->
            <set_value name="$Defaults.{'$TransferOwn'}" exact="0" comment="IGNORED from card 9b: no code reads it, own stations are never sources. Kept so old saves keep the key" />
            <set_value name="$Defaults.{'$TransferFeePercent'}" exact="2" comment="fee as percent of transfer value (Matt: 2 is OK as a placeholder)" />
            <set_value name="$Defaults.{'$TransferDelay'}" exact="0" comment="1 = delay transfers by gate distance. Instant when 0" />
            <set_value name="$Defaults.{'$TransferDelayMult'}" exact="8" comment="seconds of delay per gate jump (Matt: start at 8)" />
            <set_value name="$Defaults.{'$RangeLimit'}" exact="1" comment="1 = only use stations within RangeMaxJumps gate jumps. 0 = no distance limit" />
            <set_value name="$Defaults.{'$RangeMaxJumps'}" exact="5" comment="max gate jumps when RangeLimit is on. Minimum 1, no upper maximum" />

            <!-- ===== NPC fallback (step 10) ===== -->
            <set_value name="$Defaults.{'$NpcFallback'}" exact="1" comment="1 = buy shortfalls from NPC offers when no own station can cover (card 09r: on by default, proven in game; 0 turns it off). NPCs only qualify when the station buy price is raised above the ware minimum" />

            <!-- ===== Distribution Centres (step 9) ===== -->
            <set_value name="$Defaults.{'$DCMacros'}" exact="['dockarea_arg_m_02_tradestation_01_macro', 'pier_bor_tradestation_01_macro', 'pier_ter_tradestation_01_macro']" comment="macro ids of marker modules: a player station with one of these is a DC (Argon trade dock, Boron and Terran trade piers)" />
            <set_value name="$Defaults.{'$DCNetworkRange'}" exact="10" comment="max gate jumps between two DCs for them to join one network" />
            <set_value name="$Defaults.{'$DCKeepPercent'}" exact="10" comment="percent of each ware a DC always keeps (used from card 9b)" />
            <set_value name="$Defaults.{'$DCKeepWare'}" exact="table[]" comment="per-ware keep percent override, ware -> percent (used from card 9b)" />
            <set_value name="$Defaults.{'$LedgerMax'}" exact="200" comment="max ledger entries kept per DC (used from card 9b)" />
            <set_value name="$Defaults.{'$FeeRangeMult'}" exact="0.2" comment="fee range factor: fee x (1 + jumps x this). Default 0.2 (3 jumps = 1.6x base). Decimals allowed" />
            <set_value name="$Defaults.{'$FeeVolumeMult'}" exact="1.0" comment="fee volume factor, flat for now. Decimals allowed" />
            <set_value name="$Defaults.{'$FeeTypeMult'}" exact="1.0" comment="fee ware-type factor, flat for now. Decimals allowed" />
            <set_value name="$Defaults.{'$ReturnFeeMult'}" exact="0.5" comment="card 9c-fee: station-to-DC return fee = supply fee x this (Matt: half). The DC pays. Decimals allowed" />
            <set_value name="$Defaults.{'$DCToDCFeeMult'}" exact="0.1" comment="card 9c-fee / 9f: DC to DC pull fee = supply fee x this, paid by the home DC (Supply_Station). 0 = pulls are free. Decimals allowed" />
            <set_value name="$Defaults.{'$TriggerMinGap'}" exact="20" comment="card 9e: min seconds between two production-finished checks of the same station. Later checks wait, they are not dropped" />
            <set_value name="$Defaults.{'$LogbookSkipInterval'}" exact="600" comment="seconds before the same skipped station and ware is written to the logbook again" />
            <set_value name="$Defaults.{'$LogbookLevel'}" exact="2" comment="card 09o: game logbook detail. 0 = off, 1 = problems only, 2 = problems + one summary per supply run and DC network changes, 3 = problems + every transfer (throttled per station and ware) and DC network changes" />
            <set_value name="$Defaults.{'$NotifyMoneySkip'}" exact="1" comment="card 09o: 1 = on-screen ticker message when a transfer is skipped because a DC cannot pay. Only when LogbookLevel is 1 or more" />

            <!-- ===== Station-side settings (step 9, each can be overridden per station with Station_Cfg_Set) ===== -->
            <set_value name="$Defaults.{'$CyclesToCover'}" exact="2" comment="production cycles of resources FDN supplies ahead. Card 9e: default 2 (was 1); set back to 1 here to revert" />
            <set_value name="$Defaults.{'$ResourcesFdnManaged'}" exact="1" comment="1 = FDN supplies this station's resources" />
            <set_value name="$Defaults.{'$ProductsFdnManaged'}" exact="1" comment="1 = this station's products go to its nearest DC (card 9c)" />
            <set_value name="$Defaults.{'$ProductMinBatch'}" exact="100" comment="card 9c: smallest amount of a product sent to the DC in one go" />
            <set_value name="$Defaults.{'$ProductKeepWare'}" exact="table[]" comment="card 9c: per-ware amount a station keeps of its own product, ware -> amount. Empty = keep 0" />
          </actions>
        </library>

      </cues>
    </cue>

    <!--
      Read a setting from any FDN file:
        <run_actions ref="md.FDN_Core.Cfg_Get" result="$Value">
          <param name="Key" value="'TransferOwn'" />
        </run_actions>
      Override wins, then default, else null.
    -->
    <library name="Cfg_Get" purpose="run_actions">
      <params>
        <param name="Key" />
      </params>
      <actions>
        <set_value name="$Init" exact="md.FDN_Core.Init" />
        <set_value name="$K" exact="'$' + $Key" comment="X4-09a-fix2: table string keys must start with $" />
        <do_if value="$Init.$Overrides.{$K}?">
          <return value="$Init.$Overrides.{$K}" />
        </do_if>
        <do_elseif value="$Init.$Defaults.{$K}?">
          <return value="$Init.$Defaults.{$K}" />
        </do_elseif>
        <return value="null" />
      </actions>
    </library>

    <!--
      Card 10a. Change or reset a player setting from any FDN file (the settings menu will use these).
      Values are saved with the game in md.FDN_Core.Init.$Overrides. $Defaults is never changed.
        Cfg_Set       params Key, Value[, Source]  returns true, or false (WARN logged) when Key is not a known setting
        Cfg_Reset     params Key         removes one override, so the default applies again. Returns true
        Cfg_Reset_All no params          removes every override. Returns true
    -->
    <library name="Cfg_Set" purpose="run_actions">
      <params>
        <param name="Key" />
        <param name="Value" />
        <param name="Source" default="''" comment="card X4-10c: optional, added to the log line, e.g. ' (options page)'" />
      </params>
      <actions>
        <set_value name="$Init" exact="md.FDN_Core.Init" />
        <set_value name="$K" exact="'$' + $Key" comment="table string keys must start with $" />
        <do_if value="not $Init.$Defaults.{$K}?">
          <run_actions ref="md.FDN_Core.Log">
            <param name="Level" value="2" />
            <param name="Text" value="'setting %1 is not known, not changed'.[$Key]" />
          </run_actions>
          <return value="false" />
        </do_if>
        <do_if value="not $Init.$Overrides?">
          <set_value name="$Init.$Overrides" exact="table[]" />
        </do_if>
        <run_actions ref="md.FDN_Core.Cfg_Get" result="$Old">
          <param name="Key" value="$Key" />
        </run_actions>
        <set_value name="$Init.$Overrides.{$K}" exact="$Value" />
        <run_actions ref="md.FDN_Core.Log">
          <param name="Level" value="3" />
          <param name="Text" value="'setting %1 changed from %2 to %3%4'.[$Key, $Old, $Value, $Source]" />
        </run_actions>
        <return value="true" />
      </actions>
    </library>

    <library name="Cfg_Reset" purpose="run_actions">
      <params>
        <param name="Key" />
      </params>
      <actions>
        <set_value name="$Init" exact="md.FDN_Core.Init" />
        <set_value name="$K" exact="'$' + $Key" comment="table string keys must start with $" />
        <do_if value="$Init.$Overrides? and $Init.$Overrides.{$K}?">
          <remove_value name="$Init.$Overrides.{$K}" />
          <run_actions ref="md.FDN_Core.Log">
            <param name="Level" value="3" />
            <param name="Text" value="'setting %1 reset to default'.[$Key]" />
          </run_actions>
        </do_if>
        <return value="true" />
      </actions>
    </library>

    <library name="Cfg_Reset_All" purpose="run_actions">
      <actions>
        <set_value name="$Init" exact="md.FDN_Core.Init" />
        <set_value name="$Init.$Overrides" exact="table[]" />
        <run_actions ref="md.FDN_Core.Log">
          <param name="Level" value="3" />
          <param name="Text" value="'all settings reset to defaults'" />
        </run_actions>
        <return value="true" />
      </actions>
    </library>

    <!--
      Write a log line from any FDN file:
        <run_actions ref="md.FDN_Core.Log">
          <param name="Level" value="3" />
          <param name="Text" value="'something happened'" />
        </run_actions>
      Levels: 1 error (always logged), 2 warning, 3 info, 4 debug detail.
      Lines 2-4 are written only when DebugLog = 1 and Level is at or below LogLevel.
      Note: debug_text output only reaches the log when X4 runs with -debug and -logfile.
    -->
    <library name="Log" purpose="run_actions">
      <params>
        <param name="Level" default="3" />
        <param name="Text" />
      </params>
      <actions>
        <set_value name="$Prefix" exact="'FDN INFO'" />
        <do_if value="$Level le 1"><set_value name="$Prefix" exact="'FDN ERROR'" /></do_if>
        <do_elseif value="$Level == 2"><set_value name="$Prefix" exact="'FDN WARN'" /></do_elseif>
        <do_elseif value="$Level ge 4"><set_value name="$Prefix" exact="'FDN DEBUG'" /></do_elseif>
        <do_if value="$Level le 1">
          <debug_text text="player.age + ' ' + $Prefix + ' ' + $Text" filter="general" />
          <return />
        </do_if>
        <run_actions ref="md.FDN_Core.Cfg_Get" result="$Enabled">
          <param name="Key" value="'DebugLog'" />
        </run_actions>
        <do_if value="$Enabled">
          <run_actions ref="md.FDN_Core.Cfg_Get" result="$MaxLevel">
            <param name="Key" value="'LogLevel'" />
          </run_actions>
          <do_if value="$Level le $MaxLevel">
            <debug_text text="player.age + ' ' + $Prefix + ' ' + $Text" filter="general" />
          </do_if>
        </do_if>
      </actions>
    </library>
    <!--
      Card 09o. The one way FDN writes to the game logbook. Every entry: title 'FDN: ' + Title, source name (entity) 'FDN'.
      Tier decides whether it is written, against LogbookLevel (0 off, 1 problems, 2 + summaries and info, 3 + every transfer):
        'problem'  level 1+  written to category upkeep AND alerts, highlighted
        'summary'  level 2 only (level 3 writes each transfer instead)
        'info'     level 2+  (Category, e.g. general for DC network changes)
        'transfer' level 3   throttled per ThrottleStation + ThrottleWare + Tier for LogbookSkipInterval seconds
      Money = fee shown with the entry (money attribute, not 0). Cost = optional ware cost (NPC buys, card 09p):
      added to the money shown and named in the text. Card 09p: Money and Cost are amounts the player's DC PAID, so the
      logbook shows their total as a negative amount (money leaving, red in game); callers keep passing positive amounts. Notify = true also shows NotifyText in the ticker when NotifyMoneySkip = 1.
      Callers do their own fdn.log lines; this writes nothing to fdn.log except a level 4 debug line.
        <run_actions ref="md.FDN_Core.Logbook_Event">
          <param name="Tier" value="'problem'" />
          <param name="Title" value="'supply skipped at %1'.[$Station.knownname]" />
          <param name="Text" value="'...'" />
          <param name="Object" value="$Station" />
        </run_actions>
    -->
    <library name="Logbook_Event" purpose="run_actions">
      <params>
        <param name="Tier" default="'problem'" />
        <param name="Title" />
        <param name="Text" default="''" />
        <param name="Category" default="'upkeep'" comment="'upkeep' or 'general' (problems always upkeep + alerts)" />
        <param name="Money" default="0Cr" />
        <param name="Cost" default="null" />
        <param name="Object" default="null" />
        <param name="Notify" default="false" />
        <param name="NotifyText" default="''" />
        <param name="ThrottleStation" default="null" />
        <param name="ThrottleWare" default="null" />
      </params>
      <actions>
        <run_actions ref="md.FDN_Core.Cfg_Get" result="$Lvl">
          <param name="Key" value="'LogbookLevel'" />
        </run_actions>
        <do_if value="$Lvl == null">
          <set_value name="$Lvl" exact="2" />
        </do_if>
        <do_if value="$Lvl le 0">
          <return />
        </do_if>
        <set_value name="$Show" exact="false" />
        <do_if value="$Tier == 'problem'">
          <set_value name="$Show" exact="true" />
        </do_if>
        <do_elseif value="$Tier == 'summary'">
          <set_value name="$Show" exact="$Lvl == 2" />
        </do_elseif>
        <do_elseif value="$Tier == 'info'">
          <set_value name="$Show" exact="$Lvl ge 2" />
        </do_elseif>
        <do_elseif value="$Tier == 'transfer'">
          <set_value name="$Show" exact="$Lvl ge 3" />
        </do_elseif>
        <do_if value="not $Show">
          <return />
        </do_if>
        <do_if value="$ThrottleStation != null">
          <run_actions ref="md.FDN_Core.Cfg_Get" result="$Gap">
            <param name="Key" value="'LogbookSkipInterval'" />
          </run_actions>
          <set_value name="$Init" exact="md.FDN_Core.Init" />
          <do_if value="not $Init.$LogbookLog?">
            <set_value name="$Init.$LogbookLog" exact="[]" />
          </do_if>
          <set_value name="$Keep" exact="[]" />
          <set_value name="$Last" exact="null" />
          <do_all exact="$Init.$LogbookLog.count" counter="$k">
            <set_value name="$E" exact="$Init.$LogbookLog.{$k}" />
            <do_if value="$E.{1}.exists">
              <do_if value="$E.{1} == $ThrottleStation and $E.{2} == $ThrottleWare and $E.{3} == $Tier">
                <set_value name="$Last" exact="$E.{4}" />
              </do_if>
              <do_else>
                <append_to_list name="$Keep" exact="$E" />
              </do_else>
            </do_if>
          </do_all>
          <set_value name="$Throttled" exact="false" />
          <do_if value="$Last != null">
            <do_if value="player.age lt $Last + $Gap">
              <set_value name="$Throttled" exact="true" />
            </do_if>
          </do_if>
          <append_to_list name="$Keep" exact="[$ThrottleStation, $ThrottleWare, $Tier, (if $Throttled then $Last else player.age)]" />
          <do_while value="$Keep.count gt 100">
            <remove_value name="$Keep.{1}" comment="drops the oldest entry" />
          </do_while>
          <set_value name="$Init.$LogbookLog" exact="$Keep" />
          <do_if value="$Throttled">
            <return />
          </do_if>
        </do_if>
        <set_value name="$FullTitle" exact="'FDN: ' + $Title" />
        <set_value name="$Shown" exact="0Cr - $Money" comment="card 09p: fee paid = money leaving, shown negative (red)" />
        <set_value name="$FullText" exact="$Text" />
        <do_if value="$Cost != null">
          <set_value name="$Shown" exact="0Cr - ($Money + $Cost)" comment="card 09p: fee + ware cost paid, shown negative" />
          <set_value name="$FullText" exact="$Text + ' (ware cost %1, fee %2)'.[$Cost.formatted.default + ' Cr', $Money.formatted.default + ' Cr']" />
        </do_if>
        <set_value name="$Hi" exact="$Tier == 'problem'" />
        <set_value name="$UseObj" exact="false" comment="VERIFY in game: entity shown as source 'FDN', money shown when not 0. category must be a literal (schema enum)" />
        <do_if value="$Object != null">
          <set_value name="$UseObj" exact="$Object.exists" />
        </do_if>
        <do_if value="$Tier == 'problem'" comment="Matt: problems go to upkeep and alerts">
          <do_if value="$UseObj">
            <write_to_logbook category="upkeep" title="$FullTitle" text="$FullText" entity="'FDN'" money="$Shown" highlighted="$Hi" interaction="showonmap" object="$Object" />
            <write_to_logbook category="alerts" title="$FullTitle" text="$FullText" entity="'FDN'" money="$Shown" highlighted="$Hi" interaction="showonmap" object="$Object" />
          </do_if>
          <do_else>
            <write_to_logbook category="upkeep" title="$FullTitle" text="$FullText" entity="'FDN'" money="$Shown" highlighted="$Hi" />
            <write_to_logbook category="alerts" title="$FullTitle" text="$FullText" entity="'FDN'" money="$Shown" highlighted="$Hi" />
          </do_else>
        </do_if>
        <do_elseif value="$Category == 'general'">
          <do_if value="$UseObj">
            <write_to_logbook category="general" title="$FullTitle" text="$FullText" entity="'FDN'" money="$Shown" highlighted="$Hi" interaction="showonmap" object="$Object" />
          </do_if>
          <do_else>
            <write_to_logbook category="general" title="$FullTitle" text="$FullText" entity="'FDN'" money="$Shown" highlighted="$Hi" />
          </do_else>
        </do_elseif>
        <do_else>
          <do_if value="$UseObj">
            <write_to_logbook category="upkeep" title="$FullTitle" text="$FullText" entity="'FDN'" money="$Shown" highlighted="$Hi" interaction="showonmap" object="$Object" />
          </do_if>
          <do_else>
            <write_to_logbook category="upkeep" title="$FullTitle" text="$FullText" entity="'FDN'" money="$Shown" highlighted="$Hi" />
          </do_else>
        </do_else>
        <do_if value="$Notify">
          <run_actions ref="md.FDN_Core.Cfg_Get" result="$Tick">
            <param name="Key" value="'NotifyMoneySkip'" />
          </run_actions>
          <do_if value="$Tick == 1">
            <show_notification text="'FDN: ' + $NotifyText" comment="plain string text, as vanilla diplomacy.xml:2452" />
          </do_if>
        </do_if>
        <run_actions ref="md.FDN_Core.Log">
          <param name="Level" value="4" />
          <param name="Text" value="'logbook (%1): %2 - %3'.[$Tier, $FullTitle, $FullText]" />
        </run_actions>
      </actions>
    </library>
    <!--
      PER-STATION SETTINGS (step 8, moved in card 10a). Card 10a: a table cannot live on a station component
      (proven), so overrides are kept in md.FDN_Core.Init.$StationCfg as station -> key -> value, keyed by the
      station object the same way $Claims and $ReturnLog are (proven in game by $ReturnLog). Saved with the game.
      Lookup order: station override, then player override (Cfg_Get), then default.
        Station_Cfg_Get   params Station, Key        returns the effective value
        Station_Cfg_Set   params Station, Key, Value writes the key. Returns true, false if the station or key is unknown
        Station_Cfg_Reset params Station, Key        removes one key. Leave Key out (null) to remove all of that station's keys. Returns true
        Station_Cfg_Purge no params                  drops entries for stations that no longer exist (run each poll, like Claim_Purge)
      Nothing calls Set or Reset yet; the settings menu will.
    -->
    <library name="Station_Cfg_Get" purpose="run_actions">
      <params>
        <param name="Station" />
        <param name="Key" />
      </params>
      <actions>
        <set_value name="$Init" exact="md.FDN_Core.Init" />
        <set_value name="$K" exact="'$' + $Key" comment="X4-09a-fix2: table string keys must start with $" />
        <do_if value="$Init.$StationCfg?">
          <do_if value="$Init.$StationCfg.{$Station}?">
            <do_if value="$Init.$StationCfg.{$Station}.{$K}?">
              <return value="$Init.$StationCfg.{$Station}.{$K}" />
            </do_if>
          </do_if>
        </do_if>
        <!-- Cfg_Get adds the $ itself, so pass the plain name -->
        <run_actions ref="md.FDN_Core.Cfg_Get" result="$Value">
          <param name="Key" value="$Key" />
        </run_actions>
        <return value="$Value" />
      </actions>
    </library>

    <library name="Station_Cfg_Set" purpose="run_actions">
      <params>
        <param name="Station" />
        <param name="Key" />
        <param name="Value" />
      </params>
      <actions>
        <set_value name="$Init" exact="md.FDN_Core.Init" />
        <set_value name="$K" exact="'$' + $Key" comment="X4-09a-fix2: table string keys must start with $" />
        <do_if value="not $Station.exists or not $Init.$Defaults.{$K}?">
          <run_actions ref="md.FDN_Core.Log">
            <param name="Level" value="2" />
            <param name="Text" value="'station setting %1 not changed: station gone or setting not known'.[$Key]" />
          </run_actions>
          <return value="false" />
        </do_if>
        <do_if value="not $Init.$StationCfg?">
          <set_value name="$Init.$StationCfg" exact="table[]" />
        </do_if>
        <do_if value="not $Init.$StationCfg.{$Station}?">
          <set_value name="$Init.$StationCfg.{$Station}" exact="table[]" comment="station object as table key, same as $Claims / $ReturnLog" />
        </do_if>
        <set_value name="$Init.$StationCfg.{$Station}.{$K}" exact="$Value" />
        <run_actions ref="md.FDN_Core.Log">
          <param name="Level" value="3" />
          <param name="Text" value="'station setting %1 at %2 set to %3'.[$Key, $Station.knownname, $Value]" />
        </run_actions>
        <return value="true" />
      </actions>
    </library>

    <library name="Station_Cfg_Reset" purpose="run_actions">
      <params>
        <param name="Station" />
        <param name="Key" default="null" />
      </params>
      <actions>
        <set_value name="$Init" exact="md.FDN_Core.Init" />
        <do_if value="not $Init.$StationCfg?">
          <return value="true" />
        </do_if>
        <do_if value="not $Init.$StationCfg.{$Station}?">
          <return value="true" />
        </do_if>
        <do_if value="$Key == null">
          <remove_value name="$Init.$StationCfg.{$Station}" />
        </do_if>
        <do_else>
          <set_value name="$K" exact="'$' + $Key" comment="X4-09a-fix2: table string keys must start with $" />
          <do_if value="$Init.$StationCfg.{$Station}.{$K}?">
            <remove_value name="$Init.$StationCfg.{$Station}.{$K}" />
          </do_if>
          <do_if value="$Init.$StationCfg.{$Station}.keys.count == 0">
            <remove_value name="$Init.$StationCfg.{$Station}" />
          </do_if>
        </do_else>
        <return value="true" />
      </actions>
    </library>

    <library name="Station_Cfg_Purge" purpose="run_actions">
      <actions>
        <set_value name="$Init" exact="md.FDN_Core.Init" />
        <do_if value="not $Init.$StationCfg?">
          <return />
        </do_if>
        <set_value name="$Keys" exact="$Init.$StationCfg.keys.list" />
        <do_all exact="$Keys.count" counter="$k">
          <do_if value="not $Keys.{$k}.exists">
            <remove_value name="$Init.$StationCfg.{$Keys.{$k}}" />
          </do_if>
        </do_all>
      </actions>
    </library>

    <!--
      CLAIMS / LOCK (step 8). A claim reserves an amount of a ware at a station so two transfers
      (or a transfer and an NPC buy) do not use the same stock or fill the same gap twice.
      Stored in md.FDN_Core.Init.$Claims as station -> ware -> amount.
        Claim_Get     params Station, Ware          returns the amount currently claimed
        Claim_Add     params Station, Ware, Amount  adds to the claim (Amount must be above 0)
        Claim_Release params Station, Ware, Amount  subtracts, never below 0, removes empty entries
        Claim_Purge   no params                     drops claims for stations that no longer exist
      Nothing makes a claim yet. Step 9 will, when it queues a transfer.
    -->
    <library name="Claim_Get" purpose="run_actions">
      <params>
        <param name="Station" />
        <param name="Ware" />
      </params>
      <actions>
        <set_value name="$Init" exact="md.FDN_Core.Init" />
        <do_if value="$Init.$Claims.{$Station}.{$Ware}?">
          <return value="$Init.$Claims.{$Station}.{$Ware}" />
        </do_if>
        <return value="0" />
      </actions>
    </library>

    <library name="Claim_Add" purpose="run_actions">
      <params>
        <param name="Station" />
        <param name="Ware" />
        <param name="Amount" />
      </params>
      <actions>
        <do_if value="$Amount le 0">
          <return />
        </do_if>
        <set_value name="$Init" exact="md.FDN_Core.Init" />
        <do_if value="not $Init.$Claims.{$Station}?">
          <set_value name="$Init.$Claims.{$Station}" exact="table[]" comment="VERIFY: a station object works as a table key and nested tables can be written like this" />
        </do_if>
        <set_value name="$Current" exact="0" />
        <do_if value="$Init.$Claims.{$Station}.{$Ware}?">
          <set_value name="$Current" exact="$Init.$Claims.{$Station}.{$Ware}" />
        </do_if>
        <set_value name="$Init.$Claims.{$Station}.{$Ware}" exact="$Current + $Amount" />
        <run_actions ref="md.FDN_Core.Log">
          <param name="Level" value="4" />
          <param name="Text" value="'claim +%1 %2 at %3, now %4'.[$Amount, $Ware.name, $Station.knownname, $Current + $Amount]" />
        </run_actions>
      </actions>
    </library>

    <library name="Claim_Release" purpose="run_actions">
      <params>
        <param name="Station" />
        <param name="Ware" />
        <param name="Amount" />
      </params>
      <actions>
        <set_value name="$Init" exact="md.FDN_Core.Init" />
        <do_if value="not $Init.$Claims.{$Station}.{$Ware}?">
          <return />
        </do_if>
        <set_value name="$Left" exact="$Init.$Claims.{$Station}.{$Ware} - $Amount" />
        <do_if value="$Left gt 0">
          <set_value name="$Init.$Claims.{$Station}.{$Ware}" exact="$Left" />
        </do_if>
        <do_else>
          <remove_value name="$Init.$Claims.{$Station}.{$Ware}" />
          <do_if value="$Init.$Claims.{$Station}.keys.count == 0">
            <remove_value name="$Init.$Claims.{$Station}" />
          </do_if>
        </do_else>
        <run_actions ref="md.FDN_Core.Log">
          <param name="Level" value="4" />
          <param name="Text" value="'claim -%1 %2 at %3, left %4'.[$Amount, $Ware.name, $Station.knownname, [$Left, 0].max]" />
        </run_actions>
      </actions>
    </library>

    <library name="Claim_Purge" purpose="run_actions">
      <actions>
        <set_value name="$Init" exact="md.FDN_Core.Init" />
        <do_if value="not $Init.$Claims?">
          <return />
        </do_if>
        <set_value name="$Keys" exact="$Init.$Claims.keys.list" />
        <do_all exact="$Keys.count" counter="$k">
          <do_if value="not $Keys.{$k}.exists">
            <remove_value name="$Init.$Claims.{$Keys.{$k}}" />
          </do_if>
        </do_all>
      </actions>
    </library>

  </cues>
</mdscript>