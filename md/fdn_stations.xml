<?xml version="1.0" encoding="utf-8"?>
<mdscript name="FDN_Stations" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="md.xsd">
  <cues>
    <!--
      Step 4: registry of player stations.
      $Stations (saved list) is read from other FDN files as: md.FDN_Stations.Registry.$Stations
      Kept current by: a full rescan on game load, event_player_built_station (add),
      event_player_owned_destroyed (remove). Ownership changes (captured or sold stations) are
      caught by the purge, which also runs on load. The purge (md.FDN_Stations.Purge) runs on each poll.
      The production-finished trigger below is log-only for now; step 6 and 7 hook the supply check in.
    -->
    <cue name="Registry" version="1" checktime="5s" checkinterval="5s">
      <conditions>
        <cue_is_complete cue="md.Setup.GameStart" />
      </conditions>
      <actions>
        <set_value name="$Stations" exact="[]" />
        <set_value name="$Skip" exact="null" />
        <include_actions ref="Rescan_Stations" />
        <run_actions ref="md.FDN_Core.Log">
          <param name="Level" value="3" />
          <param name="Text" value="'registry built, %1 player stations'.[$Stations.count]" />
        </run_actions>
      </actions>
      <cues>
        <cue name="OnLoad" instantiate="true">
          <conditions>
            <event_game_loaded />
          </conditions>
          <actions>
            <set_value name="$Skip" exact="null" />
            <include_actions ref="Rescan_Stations" />
            <run_actions ref="md.FDN_Core.Log">
              <param name="Level" value="3" />
              <param name="Text" value="'registry rescanned on load, %1 player stations'.[$Stations.count]" />
            </run_actions>
          </actions>
        </cue>

        <cue name="OnBuilt" instantiate="true">
          <conditions>
            <event_player_built_station />
          </conditions>
          <actions>
            <do_if value="not $Stations.indexof.{event.param}">
              <append_to_list name="$Stations" exact="event.param" />
            </do_if>
            <run_actions ref="md.FDN_Core.Log">
              <param name="Level" value="3" />
              <param name="Text" value="'station built: %1, now %2 stations'.[event.param.knownname, $Stations.count]" />
            </run_actions>
          </actions>
        </cue>

        <cue name="OnDestroyed" instantiate="true">
          <conditions>
            <event_player_owned_destroyed />
          </conditions>
          <actions>
            <do_if value="$Stations.indexof.{event.param}">
              <run_actions ref="md.FDN_Stations.Purge">
                <param name="Skip" value="event.param" />
              </run_actions>
              <run_actions ref="md.FDN_Core.Log">
                <param name="Level" value="3" />
                <param name="Text" value="'station destroyed, now %1 stations'.[$Stations.count]" />
              </run_actions>
            </do_if>
          </actions>
        </cue>

        <!-- Log-only for now. param = production module, param2 = product ware, param3 = research flag. VERIFY: that a production module has .container (station) -->
        <cue name="OnProductionFinished" instantiate="true">
          <conditions>
            <event_player_production_finished />
          </conditions>
          <actions>
            <do_if value="not event.param3">
              <run_actions ref="md.FDN_Core.Log">
                <param name="Level" value="4" />
                <param name="Text" value="'production finished: module %1, ware %2, station %3'.[event.param, event.param2, @event.param.container]" />
              </run_actions>
            </do_if>
          </actions>
        </cue>

        <!-- Full rescan: replaces $Stations with every player-owned station in the galaxy -->
        <library name="Rescan_Stations" purpose="include_actions">
          <actions>
            <find_station name="$Found" space="player.galaxy" multiple="true" owner="faction.player" />
            <set_value name="$Stations" exact="[]" />
            <do_for_each name="$s" in="$Found">
              <append_to_list name="$Stations" exact="$s" />
            </do_for_each>
            <remove_value name="$Found" />
          </actions>
        </library>

      </cues>
    </cue>

    <!--
      Purge: keep only stations that still exist and are player-owned. Optional Skip is dropped too.
      Callable from any FDN file: <run_actions ref="md.FDN_Stations.Purge"/>
    -->
    <library name="Purge" purpose="run_actions">
      <params>
        <param name="Skip" default="null" />
      </params>
      <actions>
        <set_value name="$Reg" exact="md.FDN_Stations.Registry" />
        <set_value name="$Kept" exact="[]" />
        <do_for_each name="$s" in="$Reg.$Stations">
          <do_if value="$s.exists and $s.owner == faction.player and $s != $Skip">
            <append_to_list name="$Kept" exact="$s" />
          </do_if>
        </do_for_each>
        <set_value name="$Reg.$Stations" exact="$Kept" />
      </actions>
    </library>
  </cues>
</mdscript>